return table.freeze({
	Assembly = require(script.Assembly),
	Bindings = require(script.Bindings),
	InputState = require(script.InputState),
	RigAdapter = require(script.RigAdapter),
	TransactionRegistry = require(script.TransactionRegistry),
})
