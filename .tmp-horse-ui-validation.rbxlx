        </Properties>
        <Item class="ModuleScript" referent="238">
          <Properties>
            <string name="Name">Catalog</string>
            <string name="Source"><![CDATA[--!strict

local MarketplaceService: MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local RobuxShopCatalog: any = require(
	ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameData"):WaitForChild("RobuxShopCatalog")
)

local Catalog = {}

local function GetInfoType(ProductType: string): Enum.InfoType
	if ProductType == "GamePass" then
		return Enum.InfoType.GamePass
	end
	return Enum.InfoType.Product
end

local function BuildLiveProductPayload(Definition: any): any
	local Payload: any = RobuxShopCatalog.BuildStaticProductPayload(Definition)
	local Success: boolean, ProductInfo: any = pcall(
		MarketplaceService.GetProductInfo,
		MarketplaceService,
		Definition.ProductId,
		GetInfoType(Definition.ProductType)
	)

	Payload.IsForSale = false
	Payload.PriceInRobux = nil
	Payload.MarketplaceName = Definition.DisplayName
	if Success and type(ProductInfo) == "table" then
		Payload.IsForSale = ProductInfo.IsForSale ~= false
		Payload.PriceInRobux = tonumber(ProductInfo.PriceInRobux)
		Payload.MarketplaceName = ProductInfo.Name or Payload.MarketplaceName
		Payload.Image = RobuxShopCatalog.ResolveImageUri(Definition, ProductInfo.IconImageAssetId)
	end
	return Payload
end

function Catalog.BuildResponse(): any
	local Response: any = {
		Success = true,
		DeveloperProducts = {},
		GamePasses = {},
	}
	for _Index: number, Definition: any in RobuxShopCatalog.GetDeveloperProductDefinitions() do
		Response.DeveloperProducts[Definition.Key] = BuildLiveProductPayload(Definition)
	end
	for _Index: number, Definition: any in RobuxShopCatalog.GetGamePassDefinitions() do
		Response.GamePasses[Definition.Key] = BuildLiveProductPayload(Definition)
	end
	return Response
end

return Catalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="239">
          <Properties>
            <string name="Name">Gifts</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameData = Modules:WaitForChild("GameData")
local Utility = Modules:WaitForChild("Utility")

local serverModules = ServerStorage:WaitForChild("Modules")

local Network = require(Modules:WaitForChild("Network"))
local RobuxShopCatalog = require(GameData:WaitForChild("RobuxShopCatalog"))
local DataUtility = require(Utility:WaitForChild("DataUtility"))
local SoundUtility = require(Utility:WaitForChild("SoundUtility"))
local ProfileSessionService = require(serverModules:WaitForChild("DataStore"):WaitForChild("ProfileSessionService"))
local Catalog = require(script.Parent.Catalog)

local Gifts = {}
local ActiveReceiptHandler: any = nil

local GIFT_MESSAGE_TYPE = "RobuxProductGift"
local GIFT_INTENT_EXPIRATION_SECONDS = 180
local MAX_PENDING_GIFT_INTENTS = 8
local PROCESSED_RECEIPT_LIMIT = 100
local RECEIVED_GIFT_RECEIPT_LIMIT = 100

local function normalize_whole_number(value): number
	return math.max(0, math.floor(tonumber(value) or 0))
end

local function ensure_live_ops_tables(profileData)
	if type(profileData.Currencies) ~= "table" then
		profileData.Currencies = {}
	end

	if type(profileData.LiveOps) ~= "table" then
		profileData.LiveOps = {}
	end

	local liveOps = profileData.LiveOps

	if type(liveOps.ProcessedDeveloperReceipts) ~= "table" then
		liveOps.ProcessedDeveloperReceipts = {}
	end

	if type(liveOps.ProcessedDeveloperReceiptOrder) ~= "table" then
		liveOps.ProcessedDeveloperReceiptOrder = {}
	end

	if type(liveOps.PendingGiftPurchases) ~= "table" then
		liveOps.PendingGiftPurchases = {}
	end

	if type(liveOps.ReceivedGiftReceipts) ~= "table" then
		liveOps.ReceivedGiftReceipts = {}
	end

	if type(liveOps.ReceivedGiftReceiptOrder) ~= "table" then
		liveOps.ReceivedGiftReceiptOrder = {}
	end

	return liveOps
end

local function ensure_profile_data(player: Player)
	local profileData = DataUtility.server.get(player)
	if type(profileData) ~= "table" then
		return nil
	end

	ensure_live_ops_tables(profileData)
	return profileData
end

local function trim_receipt_history(receiptLookup, receiptOrder, maxEntries: number)
	while #receiptOrder > maxEntries do
		local expiredReceiptId = table.remove(receiptOrder, 1)
		if expiredReceiptId then
			receiptLookup[expiredReceiptId] = nil
		end
	end
end

local function prune_pending_gift_intents(profileData, nowTimestamp: number)
	local liveOps = ensure_live_ops_tables(profileData)
	local pendingGiftPurchases = liveOps.PendingGiftPurchases
	local prunedGiftPurchases = {}

	for _, giftIntent in ipairs(pendingGiftPurchases) do
		if type(giftIntent) == "table" then
			local expiresAt = normalize_whole_number(giftIntent.ExpiresAt)
			if expiresAt > nowTimestamp then
				prunedGiftPurchases[#prunedGiftPurchases + 1] = giftIntent
			end
		end
	end

	liveOps.PendingGiftPurchases = prunedGiftPurchases
	return prunedGiftPurchases
end

local function get_gift_intent_by_id(pendingGiftPurchases, intentId: string)
	for _, giftIntent in ipairs(pendingGiftPurchases) do
		if type(giftIntent) == "table" and giftIntent.IntentId == intentId then
			return giftIntent
		end
	end

	return nil
end

local function remove_gift_intent_by_id(pendingGiftPurchases, intentId: string): boolean
	for index, giftIntent in ipairs(pendingGiftPurchases) do
		if type(giftIntent) == "table" and giftIntent.IntentId == intentId then
			table.remove(pendingGiftPurchases, index)
			return true
		end
	end

	return false
end

local function get_active_confirmed_gift_intent(profileData, nowTimestamp: number)
	local pendingGiftPurchases = prune_pending_gift_intents(profileData, nowTimestamp)

	for _, giftIntent in ipairs(pendingGiftPurchases) do
		if giftIntent.State == "Confirmed" and normalize_whole_number(giftIntent.ExpiresAt) > nowTimestamp then
			return giftIntent
		end
	end

	return nil
end

local function consume_matching_gift_intent(profileData, productId: number, nowTimestamp: number)
	local pendingGiftPurchases = prune_pending_gift_intents(profileData, nowTimestamp)

	for index, giftIntent in ipairs(pendingGiftPurchases) do
		if giftIntent.State == "Confirmed"
			and normalize_whole_number(giftIntent.ProductId) == productId
			and normalize_whole_number(giftIntent.ExpiresAt) > nowTimestamp
		then
			table.remove(pendingGiftPurchases, index)
			return giftIntent
		end
	end

	return nil
end

local function save_live_ops(player: Player, profileData)
	DataUtility.server.set(player, "LiveOps", profileData.LiveOps)
end

local function can_grant_reward(reward): boolean
	if type(reward) ~= "table" then
		return false
	end

	local rewardAmount = normalize_whole_number(reward.Amount)
	if rewardAmount <= 0 then
		return true
	end

	return reward.CurrencyId == "Horseshoes"
end

local function commit_reward(player: Player, profileData, reward): boolean
	if not can_grant_reward(reward) then
		return false
	end

	local rewardAmount = normalize_whole_number(reward.Amount)
	if rewardAmount <= 0 then
		save_live_ops(player, profileData)
		return true
	end

	if reward.CurrencyId == "Horseshoes" then
		local currentHorseshoes = normalize_whole_number(DataUtility.server.get(player, "Currencies.Horseshoes"))
		DataUtility.server.set(player, "Currencies.Horseshoes", currentHorseshoes + rewardAmount)
		SoundUtility.PlayGameSFXForPlayer(player, "MoneyGet")
		return true
	end

	return false
end

local function handle_gift_message(player: Player, profile, message, processed)
	if type(message) ~= "table" or message.Type ~= GIFT_MESSAGE_TYPE then
		return false
	end

	local profileData = profile and profile.Data
	if type(profileData) ~= "table" then
		return false
	end

	local liveOps = ensure_live_ops_tables(profileData)
	local purchaseId = tostring(message.PurchaseId or "")

	if purchaseId == "" then
		processed()
		return true
	end

	if liveOps.ReceivedGiftReceipts[purchaseId] then
		processed()
		return true
	end

	if not can_grant_reward(message.Reward) then
		return false
	end

	liveOps.ReceivedGiftReceipts[purchaseId] = true
	liveOps.ReceivedGiftReceiptOrder[#liveOps.ReceivedGiftReceiptOrder + 1] = purchaseId
	trim_receipt_history(
		liveOps.ReceivedGiftReceipts,
		liveOps.ReceivedGiftReceiptOrder,
		RECEIVED_GIFT_RECEIPT_LIMIT
	)

	if not commit_reward(player, profileData, message.Reward) then
		return false
	end

	processed()
	return true
end

local function create_gift_response(success: boolean, code: string, extraData)
	local response = {
		Success = success,
		Code = code,
	}

	if type(extraData) == "table" then
		for key, value in pairs(extraData) do
			response[key] = value
		end
	end

	return response
end

local function begin_gift_purchase(player: Player, productKey, recipientUserId)
	local definition = RobuxShopCatalog.GetDefinitionByKey(productKey)
	if not definition or definition.ProductType ~= "DeveloperProduct" then
		return create_gift_response(false, "UnsupportedGiftProduct")
	end

	local profileData = ensure_profile_data(player)
	if not profileData then
		return create_gift_response(false, "ProfileNotReady")
	end

	local normalizedRecipientUserId = normalize_whole_number(recipientUserId)
	if normalizedRecipientUserId <= 0 or normalizedRecipientUserId == player.UserId then
		return create_gift_response(false, "InvalidGiftRecipient")
	end

	local recipientPlayer = Players:GetPlayerByUserId(normalizedRecipientUserId)
	if not recipientPlayer then
		return create_gift_response(false, "RecipientUnavailable")
	end

	local nowTimestamp = os.time()
	if get_active_confirmed_gift_intent(profileData, nowTimestamp) then
		return create_gift_response(false, "GiftAlreadyPending")
	end

	local liveOps = ensure_live_ops_tables(profileData)
	local pendingGiftPurchases = prune_pending_gift_intents(profileData, nowTimestamp)
	local intentId = HttpService:GenerateGUID(false)

	pendingGiftPurchases[#pendingGiftPurchases + 1] = {
		IntentId = intentId,
		ProductId = definition.ProductId,
		ProductKey = definition.Key,
		RecipientUserId = recipientPlayer.UserId,
		RecipientName = recipientPlayer.Name,
		RecipientDisplayName = recipientPlayer.DisplayName,
		State = "Draft",
		CreatedAt = nowTimestamp,
		ExpiresAt = nowTimestamp + GIFT_INTENT_EXPIRATION_SECONDS,
	}

	while #pendingGiftPurchases > MAX_PENDING_GIFT_INTENTS do
		table.remove(pendingGiftPurchases, 1)
	end

	liveOps.PendingGiftPurchases = pendingGiftPurchases
	save_live_ops(player, profileData)

	return create_gift_response(true, "GiftIntentCreated", {
		IntentId = intentId,
		ProductId = definition.ProductId,
		ProductKey = definition.Key,
		RecipientUserId = recipientPlayer.UserId,
		RecipientName = recipientPlayer.Name,
		RecipientDisplayName = recipientPlayer.DisplayName,
	})
end

local function confirm_gift_purchase(player: Player, intentId)
	if type(intentId) ~= "string" or intentId == "" then
		return create_gift_response(false, "GiftIntentMissing")
	end

	local profileData = ensure_profile_data(player)
	if not profileData then
		return create_gift_response(false, "ProfileNotReady")
	end

	local nowTimestamp = os.time()
	local pendingGiftPurchases = prune_pending_gift_intents(profileData, nowTimestamp)
	local giftIntent = get_gift_intent_by_id(pendingGiftPurchases, intentId)
	if not giftIntent then
		return create_gift_response(false, "GiftIntentNotFound")
	end

	giftIntent.State = "Confirmed"
	giftIntent.ConfirmedAt = nowTimestamp
	giftIntent.ExpiresAt = nowTimestamp + GIFT_INTENT_EXPIRATION_SECONDS

	save_live_ops(player, profileData)

	return create_gift_response(true, "GiftIntentConfirmed", {
		IntentId = giftIntent.IntentId,
		ProductId = giftIntent.ProductId,
		ProductKey = giftIntent.ProductKey,
		RecipientUserId = giftIntent.RecipientUserId,
		RecipientName = giftIntent.RecipientName,
		RecipientDisplayName = giftIntent.RecipientDisplayName,
	})
end

local function cancel_gift_purchase(player: Player, intentId)
	if type(intentId) ~= "string" or intentId == "" then
		return create_gift_response(false, "GiftIntentMissing")
	end

	local profileData = ensure_profile_data(player)
	if not profileData then
		return create_gift_response(false, "ProfileNotReady")
	end

	local pendingGiftPurchases = prune_pending_gift_intents(profileData, os.time())
	local didRemoveGiftIntent = remove_gift_intent_by_id(pendingGiftPurchases, intentId)

	if didRemoveGiftIntent then
		save_live_ops(player, profileData)
		return create_gift_response(true, "GiftIntentCanceled")
	end

	return create_gift_response(false, "GiftIntentNotFound")
end

local function process_receipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local definition = RobuxShopCatalog.GetDefinitionByProductId(receiptInfo.ProductId, "DeveloperProduct")
	if not definition then
		warn(("[CommerceRuntime] Received a receipt for unknown product %s"):format(tostring(receiptInfo.ProductId)))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local profileData = ensure_profile_data(player)
	if not profileData then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local liveOps = ensure_live_ops_tables(profileData)
	local purchaseId = tostring(receiptInfo.PurchaseId)

	if liveOps.ProcessedDeveloperReceipts[purchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local nowTimestamp = os.time()
	local matchedGiftIntent = consume_matching_gift_intent(profileData, definition.ProductId, nowTimestamp)
	local recipientUserId = matchedGiftIntent and normalize_whole_number(matchedGiftIntent.RecipientUserId) or player.UserId

	if recipientUserId == player.UserId then
		if not can_grant_reward(definition.Reward) then
			warn(("[RobuxShop] Unsupported reward for product %s."):format(definition.Key))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	else
		local giftMessageSent = ProfileSessionService.SendMessageToUserId(recipientUserId, {
			Type = GIFT_MESSAGE_TYPE,
			PurchaseId = purchaseId,
			ProductId = definition.ProductId,
			ProductKey = definition.Key,
			Reward = definition.Reward,
			SenderUserId = player.UserId,
			SenderName = player.Name,
			SenderDisplayName = player.DisplayName,
			RecipientUserId = recipientUserId,
			IntentId = matchedGiftIntent and matchedGiftIntent.IntentId or "",
			CreatedAt = nowTimestamp,
		})

		if not giftMessageSent then
			if matchedGiftIntent then
				local pendingGiftPurchases = ensure_live_ops_tables(profileData).PendingGiftPurchases
				pendingGiftPurchases[#pendingGiftPurchases + 1] = matchedGiftIntent
				save_live_ops(player, profileData)
			end

			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end

	liveOps.ProcessedDeveloperReceipts[purchaseId] = true
	liveOps.ProcessedDeveloperReceiptOrder[#liveOps.ProcessedDeveloperReceiptOrder + 1] = purchaseId
	trim_receipt_history(
		liveOps.ProcessedDeveloperReceipts,
		liveOps.ProcessedDeveloperReceiptOrder,
		PROCESSED_RECEIPT_LIMIT
	)

	if recipientUserId == player.UserId then
		if not commit_reward(player, profileData, definition.Reward) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	else
		save_live_ops(player, profileData)
	end

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Gifts.Bind(TroveValue: any): ()
	ProfileSessionService.AddMessageHandler("RobuxShopGiftGrant", handle_gift_message)
	TroveValue:Add(function(): ()
		ProfileSessionService.RemoveMessageHandler("RobuxShopGiftGrant")
	end)

	Network.Functions.GetRobuxShopCatalog:Respond(function(): any
		return Catalog.BuildResponse()
	end, TroveValue)
	Network.Functions.BeginRobuxGiftPurchase:Respond(begin_gift_purchase, TroveValue)
	Network.Functions.ConfirmRobuxGiftPurchase:Respond(confirm_gift_purchase, TroveValue)
	Network.Functions.CancelRobuxGiftPurchase:Respond(cancel_gift_purchase, TroveValue)

	local ReceiptHandler: any = process_receipt
	ActiveReceiptHandler = ReceiptHandler
	MarketplaceService.ProcessReceipt = ReceiptHandler
	TroveValue:Add(function(): ()
		if ActiveReceiptHandler == ReceiptHandler then
			ActiveReceiptHandler = nil
			MarketplaceService.ProcessReceipt = nil
		end
	end)
end

return Gifts
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="240">
        <Properties>
          <string name="Name">DataRuntime</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService: RunService = game:GetService("RunService")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))
local DataUtility: any = require(Modules:WaitForChild("Utility"):WaitForChild("DataUtility"))
local DataStoreModules: Folder = ServerStorage:WaitForChild("Modules"):WaitForChild("DataStore") :: Folder
local ProfileStore: any = require(DataStoreModules:WaitForChild("ProfileStore"))
local ProfileTemplate: any = require(DataStoreModules:WaitForChild("DataTemplate"))
local ProfileSessionService: any = require(DataStoreModules:WaitForChild("ProfileSessionService"))

local STORE_NAME: string = if RunService:IsStudio() then "StudioData.01" else "Released_Data.01"
local PLAY_TIME_INTERVAL_SECONDS: number = 60

local DataRuntime = {
	Name = "DataRuntime",
	Trove = nil :: any,
	Store = nil :: any,
	ProfilesByUserId = {} :: { [number]: any },
	PlayerTroves = {} :: { [Player]: any },
}

function DataRuntime:_ReleasePlayer(Player: Player): ()
	local Profile: any = self.ProfilesByUserId[Player.UserId]
	if Profile then
		self.ProfilesByUserId[Player.UserId] = nil
		Profile:EndSession()
	end

	local PlayerTrove: any = self.PlayerTroves[Player]
	if PlayerTrove then
		PlayerTrove:Destroy()
		self.PlayerTroves[Player] = nil
	end
end

function DataRuntime:_AttachPlayer(Player: Player): ()
	if self.ProfilesByUserId[Player.UserId] or self.PlayerTroves[Player] then
		return
	end

	local Store: any = self.Store
	if not Store then
		error("DataRuntime store is unavailable", 0)
	end

	local Profile: any = Store:StartSessionAsync(tostring(Player.UserId))
	if not Profile then
		warn(`[DataRuntime] Failed to start a profile session for {Player.Name}`)
		return
	end

	Profile:Reconcile()
	Profile:AddUserId(Player.UserId)
	self.ProfilesByUserId[Player.UserId] = Profile

	local PlayerTrove: any = Trove.new()
	self.PlayerTroves[Player] = PlayerTrove
	PlayerTrove:Add(task.spawn(function(): ()
		while Player.Parent and self.ProfilesByUserId[Player.UserId] == Profile do
			task.wait(PLAY_TIME_INTERVAL_SECONDS)
			if self.ProfilesByUserId[Player.UserId] == Profile then
				local CurrentTime: number = tonumber(Profile.Data.TimePlayed) or 0
				DataUtility.server.set(Player, "TimePlayed", CurrentTime + PLAY_TIME_INTERVAL_SECONDS)
			end
		end
	end))

	DataUtility.server.attach_profile(Player, Profile)
	ProfileSessionService.RegisterProfile(Player, Profile)
	PlayerTrove:Add(Profile.OnSessionEnd:Connect(function(): ()
		DataUtility.server.detach_profile(Player)
		if self.ProfilesByUserId[Player.UserId] == Profile then
			self.ProfilesByUserId[Player.UserId] = nil
		end
	end))
end

function DataRuntime:Init(): ()
	if self.Trove then
		return
	end

	self.Trove = Trove.new()
	self.Store = ProfileStore.New(STORE_NAME, ProfileTemplate)
	ProfileSessionService.SetStore(self.Store)
	DataUtility.server.ensure_remotes()

	self.Trove:Connect(Framework.RuntimeEvents.PlayerAdded, function(Player: Player): ()
		self:_AttachPlayer(Player)
	end)
	self.Trove:Connect(Framework.RuntimeEvents.PlayerRemoving, function(Player: Player): ()
		self:_ReleasePlayer(Player)
	end)
	self.Trove:Add(ProfileStore.OnError:Connect(function(Message: string, StoreName: string, Key: string): ()
		warn(`[ProfileStore:{StoreName} {Key}] {Message}`)
	end))
end

function DataRuntime:Destroy(): ()
	if not self.Trove then
		return
	end

	for Player: Player in table.clone(self.PlayerTroves) do
		self:_ReleasePlayer(Player)
	end
	self.Trove:Destroy()
	self.Trove = nil
	self.Store = nil
	ProfileSessionService.SetStore(nil)
end

return DataRuntime
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="241">
        <Properties>
          <string name="Name">GameplayRuntime</string>
          <string name="Source"><![CDATA[--!strict

local Players: Players = game:GetService("Players")
local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))
local DataUtility: any = require(Modules:WaitForChild("Utility"):WaitForChild("DataUtility"))

local ServerModules: Folder = ServerStorage:WaitForChild("Modules") :: Folder
local CookingModules: Folder = ServerModules:WaitForChild("Cooking") :: Folder
local FarmingModules: Folder = ServerModules:WaitForChild("Farming") :: Folder
local HorseModules: Folder = ServerModules:WaitForChild("Horse") :: Folder
local InventoryModules: Folder = ServerModules:WaitForChild("Inventory") :: Folder
local PlayerModules: Folder = ServerModules:WaitForChild("Player") :: Folder
local QuestModules: Folder = ServerModules:WaitForChild("Quest") :: Folder
local RaceModules: Folder = ServerModules:WaitForChild("Race") :: Folder
local ShopModules: Folder = ServerModules:WaitForChild("Shop") :: Folder

local ConsumableToolService: any = require(InventoryModules:WaitForChild("ConsumableToolService"))
local FarmingService: any = require(FarmingModules:WaitForChild("FarmingService"))
local FarmingShopService: any = require(FarmingModules:WaitForChild("FarmingShopService"))
local HorseAutoCareService: any = require(HorseModules:WaitForChild("HorseAutoCareService"))
local HayBaleService: any = require(HorseModules:WaitForChild("HayBaleService"))
local HorseIndexService: any = require(HorseModules:WaitForChild("HorseIndexService"))
local HorseMountService: any = require(HorseModules:WaitForChild("HorseMountService"))
local ObstacleService: any = require(HorseModules:WaitForChild("ObstacleService"))
local HorseRoamingService: any = require(HorseModules:WaitForChild("HorseRoamingService"))
local HorseSaddleAssetService: any = require(HorseModules:WaitForChild("HorseSaddleAssetService"))
local HorseService: any = require(HorseModules:WaitForChild("HorseService"))
local StableCleaningService: any = require(HorseModules:WaitForChild("StableCleaningService"))
local WaterTankService: any = require(HorseModules:WaitForChild("WaterTankService"))
local WellWaterService: any = require(HorseModules:WaitForChild("WellWaterService"))
local InventoryLoadoutService: any = require(InventoryModules:WaitForChild("InventoryLoadoutService"))
local NpcShopService: any = require(ShopModules:WaitForChild("NpcShopService"))
local PersistentToolService: any = require(InventoryModules:WaitForChild("PersistentToolService"))
local PlayerSettingsService: any = require(PlayerModules:WaitForChild("PlayerSettingsService"))
local ZoneTeleportService: any = require(PlayerModules:WaitForChild("ZoneTeleportService"))
local QuestService: any = require(QuestModules:WaitForChild("QuestService"))
local RaceService: any = require(RaceModules:WaitForChild("RaceService"))

type ServiceDefinition = {
	Name: string,
	Service: any,
	AllowFailure: boolean?,
}

local GameplayRuntime = {
	Name = "GameplayRuntime",
	Trove = nil :: any,
	Started = false,
	PendingPlayers = {} :: { [Player]: boolean },
	StartedServices = {} :: { ServiceDefinition },
}

local function SafeRequire(ModuleValue: ModuleScript, ModuleName: string): any
	local Success: boolean, Result: any = pcall(require, ModuleValue)
	if Success then
		return Result
	end
	warn(`[GameplayRuntime] Failed to require {ModuleName}: {tostring(Result)}`)
	return nil
end

local CookingService: any = SafeRequire(CookingModules:WaitForChild("CookingService") :: ModuleScript, "CookingService")

local SERVICES: { ServiceDefinition } = {
	{ Name = "HorseSaddleAssetService", Service = HorseSaddleAssetService, AllowFailure = true },
	{ Name = "HorseService", Service = HorseService, AllowFailure = true },
	{ Name = "CookingService", Service = CookingService, AllowFailure = true },
	{ Name = "FarmingShopService", Service = FarmingShopService },
	{ Name = "HorseIndexService", Service = HorseIndexService },
	{ Name = "ConsumableToolService", Service = ConsumableToolService },
	{ Name = "FarmingService", Service = FarmingService },
	{ Name = "PersistentToolService", Service = PersistentToolService },
	{ Name = "InventoryLoadoutService", Service = InventoryLoadoutService },
	{ Name = "NpcShopService", Service = NpcShopService },
	{ Name = "PlayerSettingsService", Service = PlayerSettingsService },
	{ Name = "ZoneTeleportService", Service = ZoneTeleportService },
	{ Name = "QuestService", Service = QuestService },
	{ Name = "RaceService", Service = RaceService },
	{ Name = "HorseRoamingService", Service = HorseRoamingService },
	{ Name = "HorseMountService", Service = HorseMountService },
	{ Name = "ObstacleService", Service = ObstacleService },
	{ Name = "HayBaleService", Service = HayBaleService },
	{ Name = "WaterTankService", Service = WaterTankService },
	{ Name = "HorseAutoCareService", Service = HorseAutoCareService },
	{ Name = "WellWaterService", Service = WellWaterService },
	{ Name = "StableCleaningService", Service = StableCleaningService },
}

local function UpdateLoginData(Player: Player): ()
	local Login: any = DataUtility.server.get(Player, "Login")
	if not Login then
		return
	end

	local Now: number = os.time()
	if (Login.FirstJoinAt or 0) <= 0 then
		Login.FirstJoinAt = Now
	end
	Login.LastJoinAt = Now
	Login.LoginCount = (Login.LoginCount or 0) + 1
	DataUtility.server.set(Player, "Login", Login)
end

function GameplayRuntime:_BootstrapPlayer(Player: Player): ()
	local RuntimeTrove: any = self.Trove
	if not RuntimeTrove then
		return
	end

	RuntimeTrove:Add(task.spawn(function(): ()
		local Profile: any = DataUtility.server.get(Player)
		if not self.Started or Player.Parent ~= Players or not Profile then
			return
		end

		InventoryLoadoutService.SyncPlayerTools(Player)
		UpdateLoginData(Player)
		HorseService.EnsureStarterHorse(Player)
		HorseService.RefreshHorseStatuses(Player)
		FarmingService.PlayerReady(Player)
		HayBaleService.PlayerReady(Player)
		WaterTankService.PlayerReady(Player)
		StableCleaningService.PlayerReady(Player)
		QuestService.EnsureDailyQuest(Player)
		RaceService.SyncPlayer(Player)
	end))
end

function GameplayRuntime:Init(): ()
	if self.Trove then
		return
	end

	self.Trove = Trove.new()
	self.Trove:Connect(Framework.RuntimeEvents.PlayerAdded, function(Player: Player): ()
		if self.Started then
			self:_BootstrapPlayer(Player)
		else
			self.PendingPlayers[Player] = true
		end
	end)
	self.Trove:Connect(Framework.RuntimeEvents.PlayerRemoving, function(Player: Player): ()
		self.PendingPlayers[Player] = nil
	end)
end

function GameplayRuntime:Start(): ()
	if self.Started then
		return
	end

	for _Index: number, Definition: ServiceDefinition in SERVICES do
		local Service: any = Definition.Service
		if Service and type(Service.Init) == "function" then
			local Success: boolean, ErrorValue: any = pcall(Service.Init)
			if not Success then
				if Definition.AllowFailure then
					warn(`[GameplayRuntime] Failed to initialize {Definition.Name}: {tostring(ErrorValue)}`)
					continue
				end
				error(`Required service {Definition.Name} failed to initialize: {tostring(ErrorValue)}`, 0)
			end
		end
		table.insert(self.StartedServices, Definition)
	end

	HorseService.StartStatusDecayLoop()
	self.Started = true
	for Player: Player in table.clone(self.PendingPlayers) do
		self.PendingPlayers[Player] = nil
		self:_BootstrapPlayer(Player)
	end
end

function GameplayRuntime:Destroy(): ()
	self.Started = false
	table.clear(self.PendingPlayers)

	for Index: number = #self.StartedServices, 1, -1 do
		local Definition: ServiceDefinition = self.StartedServices[Index]
		if type(Definition.Service.Destroy) == "function" then
			local Success: boolean, ErrorValue: any = pcall(Definition.Service.Destroy)
			if not Success then
				warn(`[GameplayRuntime] Failed to destroy {Definition.Name}: {tostring(ErrorValue)}`)
			end
		end
	end
	table.clear(self.StartedServices)

	if self.Trove then
		self.Trove:Destroy()
		self.Trove = nil
	end
end

return GameplayRuntime
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="242">
        <Properties>
          <string name="Name">HorseRuntime</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Trove: any = require(
	ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Libraries"):WaitForChild("Trove")
)
local InteractionHold: any = require(script.InteractionHold)
local Reveal: any = require(script.Reveal)
local ToolUse: any = require(script.ToolUse)

local HorseRuntime = {
	Name = "HorseRuntime",
	Trove = nil :: any,
}

function HorseRuntime:Init(): ()
	if self.Trove then
		return
	end

	self.Trove = Trove.new()
	Reveal.Bind(self.Trove)
	ToolUse.Bind(self.Trove)
	InteractionHold.Bind(self.Trove)
end

function HorseRuntime:Destroy(): ()
	if self.Trove then
		self.Trove:Destroy()
		self.Trove = nil
	end
end

return HorseRuntime
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="243">
          <Properties>
            <string name="Name">InteractionHold</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local Network: any = require(Modules:WaitForChild("Network"))

local HorseModules: Folder = ServerStorage:WaitForChild("Modules"):WaitForChild("Horse") :: Folder
local HorseService: any = require(HorseModules:WaitForChild("HorseService"))
local HorseRoamingService: any = require(HorseModules:WaitForChild("HorseRoamingService"))

local HeldHorseByPlayer: { [Player]: string } = {}
local InteractionHold = {}

local function ReleaseHold(Player: Player): ()
	local HeldHorseId: string? = HeldHorseByPlayer[Player]
	if not HeldHorseId then
		return
	end

	HeldHorseByPlayer[Player] = nil
	HorseRoamingService.SetInteractionHold(Player, HeldHorseId, false)
end

local function EngageHold(Player: Player, HorseId: any): ()
	if type(HorseId) ~= "string" or HorseId == "" then
		return
	end

	local Horse: any, ResolvedHorseId: string? = HorseService.GetPlayerHorse(Player, HorseId)
	if not Horse or not ResolvedHorseId then
		return
	end

	if HeldHorseByPlayer[Player] and HeldHorseByPlayer[Player] ~= ResolvedHorseId then
		ReleaseHold(Player)
	end

	HeldHorseByPlayer[Player] = ResolvedHorseId
	HorseRoamingService.SetInteractionHold(Player, ResolvedHorseId, true)
end

function InteractionHold.Bind(TroveValue: any): ()
	local InteractionHoldEvent: any = Network.Horse and Network.Horse.InteractionHold
	if InteractionHoldEvent and type(InteractionHoldEvent.Connect) == "function" then
		InteractionHoldEvent:Connect(function(Player: Player, HorseId: any, IsStarting: any): ()
			if IsStarting == true then
				EngageHold(Player, HorseId)
			else
				ReleaseHold(Player)
			end
		end, TroveValue)
	end

	TroveValue:Connect(Framework.RuntimeEvents.PlayerRemoving, function(Player: Player): ()
		HeldHorseByPlayer[Player] = nil
		HorseRoamingService.ReleaseInteractionHolds(Player)
	end)

	TroveValue:Add(function(): ()
		for Player: Player, _ in HeldHorseByPlayer do
			HorseRoamingService.ReleaseInteractionHolds(Player)
		end
		table.clear(HeldHorseByPlayer)
	end)
end

return InteractionHold
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="244">
          <Properties>
            <string name="Name">Reveal</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Network: any = require(Modules:WaitForChild("Network"))
local DataUtility: any = require(Modules:WaitForChild("Utility"):WaitForChild("DataUtility"))

local Reveal = {}

function Reveal.Bind(TroveValue: any): ()
	Network.Horse.AcknowledgeReveal:Connect(function(Player: Player, HorseId: any): ()
		local PendingReveal: any = DataUtility.server.get(Player, "Progression.PendingHorseReveal")
		if type(PendingReveal) ~= "table" then
			return
		end

		if type(HorseId) == "string" and HorseId ~= "" and PendingReveal.HorseId ~= HorseId then
			return
		end

		DataUtility.server.set(Player, "Progression.PendingHorseReveal", nil)
		DataUtility.server.set(Player, "Progression.StarterRevealAcknowledged", true)
	end, TroveValue)
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="245">
          <Properties>
            <string name="Name">ToolUse</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local Network: any = require(Modules:WaitForChild("Network"))
local ToolRegistry: any = require(Modules:WaitForChild("Game"):WaitForChild("Tools"):WaitForChild("Registry"))
local CareItemCatalog: any = require(Modules:WaitForChild("GameData"):WaitForChild("CareItemCatalog"))
local HorseService: any = require(
	ServerStorage:WaitForChild("Modules"):WaitForChild("Horse"):WaitForChild("HorseService")
)

local ActiveUseByPlayer: { [Player]: boolean } = {}
local ActiveBrushAnimationByPlayer: { [Player]: string } = {}
local ActiveFeedAnimationByPlayer: { [Player]: string } = {}
local ToolUse = {}
local StopFeedAnimation: (Player, any) -> ()

local function IsToolEquippedByPlayer(Player: Player, ToolValue: Tool): boolean
	local Character: Model? = Player.Character
	return Character ~= nil and ToolValue.Parent == Character
end

local function StopBrushAnimation(Player: Player, HorseId: any): ()
	local ActiveHorseId: string? = ActiveBrushAnimationByPlayer[Player]
	if not ActiveHorseId or HorseId ~= ActiveHorseId then
		return
	end

	ActiveBrushAnimationByPlayer[Player] = nil
	HorseService.StopBrushAnimation(Player, ActiveHorseId)
end

local function StartBrushAnimation(Player: Player, ToolValue: Instance?, HorseId: any): ()
	if not ToolValue or not ToolValue:IsA("Tool") or type(HorseId) ~= "string" or HorseId == "" then
		return
	end
	if not IsToolEquippedByPlayer(Player, ToolValue) then
		return
	end

	local Definition: any, ResolvedItemId: string? = ToolRegistry.resolve_definition_from_tool(ToolValue)
	if not Definition or ResolvedItemId ~= "horse_brush" then
		return
	end

	local Horse: any, ResolvedHorseId: string? = HorseService.GetPlayerHorse(Player, HorseId)
	if not Horse or not ResolvedHorseId then
		return
	end

	StopFeedAnimation(Player, ActiveFeedAnimationByPlayer[Player])
	StopBrushAnimation(Player, ActiveBrushAnimationByPlayer[Player])
	local Started: boolean = HorseService.PlayBrushAnimation(Player, ResolvedHorseId)
	if not Started then
		return
	end

	ActiveBrushAnimationByPlayer[Player] = ResolvedHorseId
	task.delay(3, function(): ()
		StopBrushAnimation(Player, ResolvedHorseId)
	end)
end

StopFeedAnimation = function(Player: Player, HorseId: any): ()
	local ActiveHorseId: string? = ActiveFeedAnimationByPlayer[Player]
	if not ActiveHorseId or HorseId ~= ActiveHorseId then
		return
	end

	ActiveFeedAnimationByPlayer[Player] = nil
	HorseService.StopFeedAnimation(Player, ActiveHorseId)
end

local function StartFeedAnimation(Player: Player, ToolValue: Instance?, HorseId: any, Duration: any): ()
	if not ToolValue or not ToolValue:IsA("Tool") or type(HorseId) ~= "string" or HorseId == "" then
		return
	end
	if not IsToolEquippedByPlayer(Player, ToolValue) then
		return
	end

	local Definition: any, ResolvedItemId: string? = ToolRegistry.resolve_definition_from_tool(ToolValue)
	local CareItemDefinition: any = ResolvedItemId and CareItemCatalog.GetItemDefinition(ResolvedItemId) or nil
	if not Definition or not CareItemDefinition or CareItemDefinition.CareType ~= "Food" then
		return
	end

	local Horse: any, ResolvedHorseId: string? = HorseService.GetPlayerHorse(Player, HorseId)
	if not Horse or not ResolvedHorseId then
		return
	end

	StopBrushAnimation(Player, ActiveBrushAnimationByPlayer[Player])
	StopFeedAnimation(Player, ActiveFeedAnimationByPlayer[Player])
	local Started: boolean = HorseService.PlayFeedAnimation(Player, ResolvedHorseId)
	if not Started then
		return
	end

	ActiveFeedAnimationByPlayer[Player] = ResolvedHorseId
	local AnimationDuration = if type(Duration) == "number" then math.clamp(Duration, 0.05, 30) else 3
	task.delay(AnimationDuration + 0.5, function(): ()
		StopFeedAnimation(Player, ResolvedHorseId)
	end)
end

local function UseHorseTool(
	Player: Player,
	ToolValue: Instance?,
	ItemId: string?,
	HorseId: string
): (boolean, string)
	if ActiveUseByPlayer[Player] then
		return false, "Busy"
	end
	if not ToolValue or not ToolValue:IsA("Tool") then
		return false, "InvalidTool"
	end
	if type(HorseId) ~= "string" or HorseId == "" then
		return false, "InvalidHorseId"
	end
	if not IsToolEquippedByPlayer(Player, ToolValue) then
		return false, "ToolNotEquipped"
	end

	local Definition: any, ResolvedItemId: string? = ToolRegistry.resolve_definition_from_tool(ToolValue)
	if not Definition or not ResolvedItemId then
		return false, "ToolNotRegistered"
	end

	local RequestedItemId: string? = ItemId
	if type(RequestedItemId) == "string" then
		RequestedItemId = string.lower(RequestedItemId)
	end
	if RequestedItemId ~= nil and RequestedItemId ~= ResolvedItemId then
		return false, "ItemMismatch"
	end

	local Horse: any, ResolvedHorseId: string? = HorseService.GetPlayerHorse(Player, HorseId)
	if not Horse or not ResolvedHorseId then
		return false, "HorseNotOwned"
	end

	local Context: any = {
		player = Player,
		tool = ToolValue,
		itemId = ResolvedItemId,
		horse = Horse,
		horseId = ResolvedHorseId,
	}
	if type(Definition.canUse) == "function" then
		local CanUse: boolean?, CanUseReason: string? = Definition.canUse(Context)
		if CanUse ~= true then
			return false, CanUseReason or "CannotUse"
		end
	end

	ActiveUseByPlayer[Player] = true
	local Success: boolean, Result: any, Reason: any = pcall(function(): (any, any)
		if type(Definition.onUse) == "function" then
			return Definition.onUse(Context)
		end
		return true, "Used"
	end)
	ActiveUseByPlayer[Player] = nil

	if not Success then
		warn(`[HorseRuntime] Failed to use {ResolvedItemId} for {Player.Name}: {tostring(Result)}`)
		return false, "UseFailed"
	end

	local WasUsed: boolean = Result == true
	local ResponseReason: string = Reason or (if WasUsed then "Used" else "Rejected")
	if WasUsed and Definition.consumeOnUse ~= false and ToolValue.Parent then
		ToolValue:Destroy()
	end
	return WasUsed, ResponseReason
end

function ToolUse.Bind(TroveValue: any): ()
	Network.Horse.UseTool:Respond(UseHorseTool, TroveValue)
	Network.Horse.BrushAnimation:Connect(function(Player: Player, ToolValue: Instance?, HorseId: any, IsStarting: any): ()
		if IsStarting == true then
			StartBrushAnimation(Player, ToolValue, HorseId)
		else
			StopBrushAnimation(Player, HorseId)
		end
	end, TroveValue)
	local FeedAnimationEvent: any = Network.Horse and Network.Horse.FeedAnimation
	if FeedAnimationEvent and type(FeedAnimationEvent.Connect) == "function" then
		FeedAnimationEvent:Connect(function(
			Player: Player,
			ToolValue: Instance?,
			HorseId: any,
			IsStarting: any,
			Duration: any
		): ()
			if IsStarting == true then
				StartFeedAnimation(Player, ToolValue, HorseId, Duration)
			else
				StopFeedAnimation(Player, HorseId)
			end
		end, TroveValue)
	end
	TroveValue:Connect(Framework.RuntimeEvents.PlayerRemoving, function(Player: Player): ()
		ActiveUseByPlayer[Player] = nil
		StopBrushAnimation(Player, ActiveBrushAnimationByPlayer[Player])
		StopFeedAnimation(Player, ActiveFeedAnimationByPlayer[Player])
	end)
	TroveValue:Add(function(): ()
		table.clear(ActiveUseByPlayer)
		for Player: Player, HorseId: string in ActiveBrushAnimationByPlayer do
			HorseService.StopBrushAnimation(Player, HorseId)
		end
		table.clear(ActiveBrushAnimationByPlayer)
		for Player: Player, HorseId: string in ActiveFeedAnimationByPlayer do
			HorseService.StopFeedAnimation(Player, HorseId)
		end
		table.clear(ActiveFeedAnimationByPlayer)
	end)
end

return ToolUse
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="246">
        <Properties>
          <string name="Name">NetworkRuntime</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Network: any = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Network"))

local NetworkRuntime = {
	Name = "NetworkRuntime",
}

function NetworkRuntime:Init(): ()
	Network.Init()
end

return NetworkRuntime
]]></string>
