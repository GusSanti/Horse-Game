          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local localPlayer = Players.LocalPlayer
local SoundUtility = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Utility"):WaitForChild("SoundUtility"))
local HudAnim = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Libraries"):WaitForChild("HudAnim"))

local Notifications = {}

local MAIN_UI_NAME = "MainUI"
local MAINFRAME_NAME = "MainframeFR"
local DIALOGUE_FRAME_NAMES = { "DialogueFR" }
local CONFIRMATION_FRAME_NAMES = { "ConfirmationFR" }
local TASKS_FRAME_NAMES = { "TasksFR" }
local FEEDING_FRAME_NAMES = { "FeedingFR", "LoadingFR" }
local TITLE_NAMES = { "DialogueNameTX" }
local TITLE_SHADOW_NAMES = { "DialogueNameShadowTX" }
local DETAILS_NAMES = { "DetailsTX" }
local ACCEPT_BUTTON_NAMES = { "Accept" }
local DENY_BUTTON_NAMES = { "Deny" }

local DIALOGUE_OPEN_ANIM = "drop"
local DIALOGUE_OPEN_TIME = 0.28
local DIALOGUE_OPEN_OFFSET = 52
local DIALOGUE_HUD_FADE_EXCLUSIONS = "HUDFR"

local activeNotificationId = nil
local buttonConnections = {}
local cachedMainframe = nil
local cachedDialogueReferences = nil

local function normalize_key(value: string?): string?
	if type(value) ~= "string" then
		return nil
	end

	local normalizedValue = string.lower(string.gsub(value, "^%s*(.-)%s*$", "%1"))
	return normalizedValue ~= "" and normalizedValue or nil
end

local function matches_alias(instance: Instance, aliases: {string}): boolean
	local instanceName = normalize_key(instance.Name)
	if not instanceName then
		return false
	end

	for _, alias in ipairs(aliases) do
		if instanceName == normalize_key(alias) then
			return true
		end
	end

	return false
end

local function find_named_instance(root: Instance?, aliases: {string}, className: string?): Instance?
	if not root then
		return nil
	end

	for _, descendant in ipairs(root:GetDescendants()) do
		if matches_alias(descendant, aliases) and (not className or descendant:IsA(className)) then
			return descendant
		end
	end

	return nil
end

local function get_mainframe(): Instance?
	if cachedMainframe and cachedMainframe.Parent then
		return cachedMainframe
	end

	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return nil
	end

	local mainUi = playerGui:FindFirstChild(MAIN_UI_NAME) or playerGui:FindFirstChild(MAIN_UI_NAME, true)
	if not mainUi then
		return nil
	end

	cachedMainframe = mainUi:FindFirstChild(MAINFRAME_NAME) or mainUi:FindFirstChild(MAINFRAME_NAME, true)
	return cachedMainframe
end

local function get_dialogue_references()
	if cachedDialogueReferences
		and cachedDialogueReferences.Dialogue.Parent
		and cachedDialogueReferences.AcceptButton
		and cachedDialogueReferences.AcceptButton.Parent
		and cachedDialogueReferences.DenyButton
		and cachedDialogueReferences.DenyButton.Parent
	then
		return cachedDialogueReferences
	end

	local mainframe = get_mainframe()
	local dialogue = find_named_instance(mainframe, DIALOGUE_FRAME_NAMES, "GuiObject")
	if not dialogue then
		return nil
	end

	cachedDialogueReferences = {
		Dialogue = dialogue :: GuiObject,
		Title = find_named_instance(dialogue, TITLE_NAMES, "TextLabel") :: TextLabel?,
		TitleShadow = find_named_instance(dialogue, TITLE_SHADOW_NAMES, "TextLabel") :: TextLabel?,
		Details = find_named_instance(dialogue, DETAILS_NAMES, "TextLabel") :: TextLabel?,
		AcceptButton = find_named_instance(dialogue, ACCEPT_BUTTON_NAMES, "GuiButton") :: GuiButton?,
		DenyButton = find_named_instance(dialogue, DENY_BUTTON_NAMES, "GuiButton") :: GuiButton?,
	}
	return cachedDialogueReferences
end

local function ensure_dialogue_animation(dialogue: GuiObject): ()
	if dialogue:GetAttribute("open_anim") == nil then
		dialogue:SetAttribute("open_anim", DIALOGUE_OPEN_ANIM)
	end

	if dialogue:GetAttribute("open_t") == nil then
		dialogue:SetAttribute("open_t", DIALOGUE_OPEN_TIME)
	end

	if dialogue:GetAttribute("open_offset_px") == nil then
		dialogue:SetAttribute("open_offset_px", DIALOGUE_OPEN_OFFSET)
	end

	-- Notifications overlay the HUD; fading every HUD descendant creates dozens
	-- of transient tweens and can stall low-end clients when a dialogue appears.
	if dialogue:GetAttribute("HudFadeExclusions") == nil then
		dialogue:SetAttribute("HudFadeExclusions", DIALOGUE_HUD_FADE_EXCLUSIONS)
	end
end

local function disconnect_buttons(): ()
	for _, connection in ipairs(buttonConnections) do
		connection:Disconnect()
	end

	table.clear(buttonConnections)
end

local function hide_confirmation_root(): ()
	local confirmation = find_named_instance(get_mainframe(), CONFIRMATION_FRAME_NAMES, "GuiObject")
	if confirmation then
		(confirmation :: GuiObject).Visible = false
	end
end

local function hide_task_panels(): ()
	local mainframe = get_mainframe()
	local tasks = find_named_instance(mainframe, TASKS_FRAME_NAMES, "GuiObject")
	local feeding = find_named_instance(tasks or mainframe, FEEDING_FRAME_NAMES, "GuiObject")

	if feeding then
		(feeding :: GuiObject).Visible = false
	end

	if tasks then
		(tasks :: GuiObject).Visible = false
	end
end

local function set_text_pair(primary: TextLabel?, shadow: TextLabel?, value: string?): ()
	if type(value) ~= "string" then
		return
	end

	if primary then
		primary.Text = value
	end

	if shadow then
		shadow.Text = value
	end
end

local function set_button_text(button: GuiButton?, value: string?): ()
	if not button or type(value) ~= "string" or value == "" then
		return
	end

	if button:IsA("TextButton") then
		button.Text = value
	end

	for _, descendant in ipairs(button:GetDescendants()) do
		if descendant:IsA("TextLabel") then
			descendant.Text = value
		end
	end
end

function Notifications.ShowDialogue(config): boolean
	config = config or {}

	local refs = get_dialogue_references()
	if not refs or not refs.AcceptButton or not refs.DenyButton then
		return false
	end

	disconnect_buttons()
	hide_confirmation_root()
	if config.hideTasks == true then
		hide_task_panels()
	end

	activeNotificationId = config.id
	ensure_dialogue_animation(refs.Dialogue)
	HudAnim.play_open(refs.Dialogue)
	SoundUtility.PlayGameSFX("Popup")
	set_text_pair(refs.Title, refs.TitleShadow, config.title or "Notification")
	set_text_pair(refs.Details, nil, config.details or "")
	set_button_text(refs.AcceptButton, config.acceptText)
	set_button_text(refs.DenyButton, config.denyText)

	buttonConnections[#buttonConnections + 1] = refs.AcceptButton.MouseButton1Click:Connect(function()
		Notifications.HideDialogue(config.id)
		if type(config.onAccept) == "function" then
			config.onAccept()
		end
	end)

	buttonConnections[#buttonConnections + 1] = refs.DenyButton.MouseButton1Click:Connect(function()
		Notifications.HideDialogue(config.id)
		if type(config.onDeny) == "function" then
			config.onDeny()
		end
	end)

	return true
end

function Notifications.UpdateDialogue(id, config): boolean
	if activeNotificationId ~= id then
		return false
	end

	local refs = get_dialogue_references()
	if not refs or not refs.Dialogue.Visible then
		return false
	end

	config = config or {}
	set_text_pair(refs.Title, refs.TitleShadow, config.title)
	set_text_pair(refs.Details, nil, config.details)
	set_button_text(refs.AcceptButton, config.acceptText)
	set_button_text(refs.DenyButton, config.denyText)
	return true
end

function Notifications.IsDialogueActive(id): boolean
	return activeNotificationId == id
end

function Notifications.HideDialogue(id): boolean
	if id ~= nil and activeNotificationId ~= id then
		return false
	end

	local refs = get_dialogue_references()
	disconnect_buttons()
	hide_confirmation_root()

	if refs then
		if refs.Dialogue.Visible then
			HudAnim.play_close(refs.Dialogue)
		else
			refs.Dialogue.Visible = false
		end
	end

	activeNotificationId = nil
	return refs ~= nil
end

local initialReferences = get_dialogue_references()
if initialReferences then
	ensure_dialogue_animation(initialReferences.Dialogue)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">OutlinedText</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))

local FONT_FACE: Font = Font.fromEnum(Enum.Font.GothamBlack)
local ICON_ATTRIBUTE: string = "IsTextIcon"
local IGNORE_ATTRIBUTE: string = "IgnoreOutlinedText"
local OUTLINE_NAME: string = "TextOutline"
local THICKNESS_ATTRIBUTE: string = "TextOutlineThickness"
local TRANSPARENCY_ATTRIBUTE: string = "TextOutlineTransparency"

type StyledText = TextLabel | TextButton | TextBox
type TextState = {
	OriginalFontFace: Font,
	OriginalStrokeColor: Color3,
	OriginalStrokeTransparency: number,
	OriginalOutlineColor: Color3,
	OriginalOutlineThickness: number,
	OriginalOutlineTransparency: number,
	OriginalOutlineEnabled: boolean,
	Outline: UIStroke,
	Trove: any,
}

local States: { [StyledText]: TextState } = setmetatable({}, { __mode = "k" }) :: any

local OutlinedText = {
	IconAttribute = ICON_ATTRIBUTE,
	IgnoreAttribute = IGNORE_ATTRIBUTE,
}

local function IsStyledText(InstanceValue: Instance): boolean
	return InstanceValue:IsA("TextLabel") or InstanceValue:IsA("TextButton") or InstanceValue:IsA("TextBox")
end

local function HasTrueAttribute(InstanceValue: Instance, AttributeName: string): boolean
	local Current: Instance? = InstanceValue
	while Current do
		if Current:GetAttribute(AttributeName) == true then
			return true
		end
		Current = Current.Parent
	end
	return false
end

local function IsIgnored(TextObject: StyledText): boolean
	return HasTrueAttribute(TextObject, IGNORE_ATTRIBUTE) or HasTrueAttribute(TextObject, ICON_ATTRIBUTE)
end

local function GetNumberAttribute(InstanceValue: Instance, AttributeName: string): number?
	local Value: any = InstanceValue:GetAttribute(AttributeName)
	if type(Value) == "number" then
		return Value
	end
	return nil
end

local function ResolveThickness(TextObject: StyledText): number
	local Override: number? = GetNumberAttribute(TextObject, THICKNESS_ATTRIBUTE)
	if Override then
		return math.clamp(Override, 0, 8)
	end

	local ReferenceSize: number = TextObject.TextSize
	if TextObject.TextScaled and TextObject.AbsoluteSize.Y > 0 then
		ReferenceSize = math.min(48, math.max(12, TextObject.AbsoluteSize.Y * 0.48))
	end

	return math.clamp(ReferenceSize * 0.075, 1, 3.5)
end

local function ResolveTransparency(TextObject: StyledText): number
	local Override: number? = GetNumberAttribute(TextObject, TRANSPARENCY_ATTRIBUTE)
	if Override then
		return math.clamp(Override, 0, 1)
	end
	return 0.05
end

local function ApplyVisual(TextObject: StyledText, State: TextState): ()
	if IsIgnored(TextObject) then
		if TextObject.FontFace ~= State.OriginalFontFace then
			TextObject.FontFace = State.OriginalFontFace
		end
		TextObject.TextStrokeColor3 = State.OriginalStrokeColor
		TextObject.TextStrokeTransparency = State.OriginalStrokeTransparency
		State.Outline.Enabled = false
		return
	end

	if TextObject.FontFace ~= FONT_FACE then
		TextObject.FontFace = FONT_FACE
	end
	TextObject.TextStrokeTransparency = 1
	State.Outline.Enabled = true
	State.Outline.Color = Color3.new(0, 0, 0)
	State.Outline.Thickness = ResolveThickness(TextObject)
	State.Outline.Transparency = ResolveTransparency(TextObject)
end

local function Restore(TextObject: StyledText, State: TextState): ()
	pcall(function(): ()
		TextObject.FontFace = State.OriginalFontFace
		TextObject.TextStrokeColor3 = State.OriginalStrokeColor
		TextObject.TextStrokeTransparency = State.OriginalStrokeTransparency
		State.Outline.Color = State.OriginalOutlineColor
		State.Outline.Thickness = State.OriginalOutlineThickness
		State.Outline.Transparency = State.OriginalOutlineTransparency
		State.Outline.Enabled = State.OriginalOutlineEnabled
	end)
end

function OutlinedText.bind(InstanceValue: Instance): ()
	if not IsStyledText(InstanceValue) then
		return
	end

	local TextObject: StyledText = InstanceValue :: StyledText
	local ExistingState: TextState? = States[TextObject]
	if ExistingState then
		ApplyVisual(TextObject, ExistingState)
		return
	end

	if IsIgnored(TextObject) then
		return
	end

	local TextTrove: any = Trove.new()
	local Outline: UIStroke? = TextObject:FindFirstChild(OUTLINE_NAME) :: UIStroke?
	if not Outline or not Outline:IsA("UIStroke") then
		Outline = TextObject:FindFirstChildWhichIsA("UIStroke")
	end
	if not Outline then
		Outline = Instance.new("UIStroke")
		Outline.Name = OUTLINE_NAME
		Outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		Outline.LineJoinMode = Enum.LineJoinMode.Round
		Outline.Parent = TextObject
		TextTrove:Add(Outline)
	end
	Outline = Outline :: UIStroke
	Outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	Outline.LineJoinMode = Enum.LineJoinMode.Round

	local State: TextState = {
		OriginalFontFace = TextObject.FontFace,
		OriginalStrokeColor = TextObject.TextStrokeColor3,
		OriginalStrokeTransparency = TextObject.TextStrokeTransparency,
		OriginalOutlineColor = Outline.Color,
		OriginalOutlineThickness = Outline.Thickness,
		OriginalOutlineTransparency = Outline.Transparency,
		OriginalOutlineEnabled = Outline.Enabled,
		Outline = Outline,
		Trove = TextTrove,
	}
	States[TextObject] = State

	local function Refresh(): ()
		if States[TextObject] == State and TextObject.Parent then
			ApplyVisual(TextObject, State)
		end
	end

	TextTrove:Connect(TextObject:GetPropertyChangedSignal("TextSize"), Refresh)
	TextTrove:Connect(TextObject:GetPropertyChangedSignal("TextScaled"), Refresh)
	TextTrove:Connect(TextObject:GetPropertyChangedSignal("AbsoluteSize"), Refresh)
	TextTrove:Connect(TextObject:GetPropertyChangedSignal("FontFace"), Refresh)
	TextTrove:Connect(TextObject:GetAttributeChangedSignal(ICON_ATTRIBUTE), Refresh)
	TextTrove:Connect(TextObject:GetAttributeChangedSignal(IGNORE_ATTRIBUTE), Refresh)
	TextTrove:Connect(TextObject:GetAttributeChangedSignal(THICKNESS_ATTRIBUTE), Refresh)
	TextTrove:Connect(TextObject:GetAttributeChangedSignal(TRANSPARENCY_ATTRIBUTE), Refresh)
	TextTrove:Connect(TextObject.AncestryChanged, function(_Child: Instance, Parent: Instance?): ()
		if Parent or States[TextObject] ~= State then
			return
		end

		States[TextObject] = nil
		Restore(TextObject, State)
		TextTrove:Destroy()
	end)

	ApplyVisual(TextObject, State)
end

function OutlinedText.unbind(InstanceValue: Instance): ()
	if not IsStyledText(InstanceValue) then
		return
	end

	local TextObject: StyledText = InstanceValue :: StyledText
	local State: TextState? = States[TextObject]
	if not State then
		return
	end

	States[TextObject] = nil
	Restore(TextObject, State)
	State.Trove:Destroy()
end

function OutlinedText.bind_all(Root: Instance): ()
	OutlinedText.bind(Root)
	for _Index: number, Descendant: Instance in Root:GetDescendants() do
		OutlinedText.bind(Descendant)
	end
end

function OutlinedText.unbind_all(Root: Instance): ()
	OutlinedText.unbind(Root)
	for _Index: number, Descendant: Instance in Root:GetDescendants() do
		OutlinedText.unbind(Descendant)
	end
end

function OutlinedText.destroy(): ()
	local BoundText: { StyledText } = {}
	for TextObject: StyledText in States do
		table.insert(BoundText, TextObject)
	end

	for _Index: number, TextObject: StyledText in BoundText do
		OutlinedText.unbind(TextObject)
	end
end

return OutlinedText
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">PromptChoices</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Libraries: Folder = Modules:WaitForChild("Libraries") :: Folder
local HudAnim: any = require(Libraries:WaitForChild("HudAnim"))
local TweenUtils: any = require(Libraries:WaitForChild("HudAnim"):WaitForChild("Utils"))
local Trove: any = require(Libraries:WaitForChild("Trove"))

export type Choice = {
	Id: string,
	Text: string,
	Activate: () -> (),
}

export type PromptChoices = {
	_PlayerGui: PlayerGui,
	_Session: any?,
	_Prompt: ProximityPrompt?,
	Open: (self: PromptChoices, Prompt: ProximityPrompt, Choices: { Choice }) -> (),
	Close: (self: PromptChoices, Immediate: boolean?) -> (),
	Destroy: (self: PromptChoices) -> (),
}

local PANEL_WIDTH: number = 218
local CHOICE_HEIGHT: number = 42
local CHOICE_GAP: number = 7
local PANEL_PADDING: number = 8
local OPEN_DURATION: number = 0.24
local CLOSE_DURATION: number = 0.12
local OPEN_SCALE: number = 0.82
local CORNER_RADIUS: number = 7
local PANEL_COLOR: Color3 = Color3.fromRGB(24, 24, 24)
local BUTTON_COLOR: Color3 = Color3.fromRGB(38, 38, 38)
local STROKE_COLOR: Color3 = Color3.fromRGB(0, 0, 0)
local PROMPT_OPEN_ATTRIBUTE: string = "PromptChoicesOpen"

local PromptChoices = {}
PromptChoices.__index = PromptChoices

local function AddCorner(Parent: Instance, Radius: number): UICorner
	local Corner: UICorner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, Radius)
	Corner.Parent = Parent
	return Corner
end

local function AddStroke(Parent: Instance, Thickness: number, Transparency: number): UIStroke
	local Stroke: UIStroke = Instance.new("UIStroke")
	Stroke.Color = STROKE_COLOR
	Stroke.Thickness = Thickness
	Stroke.Transparency = Transparency
	Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	Stroke.Parent = Parent
	return Stroke
end

local function ResolveAdornee(Prompt: ProximityPrompt): Instance?
	local Parent: Instance? = Prompt.Parent
	if Parent and (Parent:IsA("Attachment") or Parent:IsA("BasePart")) then
		return Parent
	end
	return nil
end

local function BuildChoice(ButtonParent: Instance, ChoiceValue: Choice, LayoutOrder: number): TextButton
	local Button: TextButton = Instance.new("TextButton")
	Button.Name = ChoiceValue.Id
	Button.AutoButtonColor = false
	Button.BackgroundColor3 = BUTTON_COLOR
	Button.BackgroundTransparency = 0.08
	Button.BorderSizePixel = 0
	Button.Font = Enum.Font.GothamBlack
	Button.LayoutOrder = LayoutOrder
	Button.Size = UDim2.new(1, 0, 0, CHOICE_HEIGHT)
	Button.Text = ChoiceValue.Text
	Button.TextColor3 = Color3.new(1, 1, 1)
	Button.TextScaled = true
	Button.TextStrokeColor3 = STROKE_COLOR
	Button.TextStrokeTransparency = 0
	Button:SetAttribute("UIAnim", true)
	Button.Parent = ButtonParent

	local TextConstraint: UITextSizeConstraint = Instance.new("UITextSizeConstraint")
	TextConstraint.MinTextSize = 13
	TextConstraint.MaxTextSize = 19
	TextConstraint.Parent = Button

	AddCorner(Button, CORNER_RADIUS)
	AddStroke(Button, 2, 0)
	HudAnim.bind(Button)
	return Button
end

function PromptChoices.new(PlayerGuiValue: PlayerGui): PromptChoices
	local Self: PromptChoices = setmetatable({
		_PlayerGui = PlayerGuiValue,
		_Session = nil,
		_Prompt = nil,
	}, PromptChoices) :: any
	return Self
end

function PromptChoices:Close(Immediate: boolean?): ()
	local Session: any = self._Session
	if not Session then
		return
	end

	self._Session = nil
	self._Prompt = nil
	local Billboard: BillboardGui? = Session.Billboard
	local Group: CanvasGroup? = Session.Group
	local Scale: UIScale? = Session.Scale
	if Immediate == true or not Billboard or not Billboard.Parent or not Group or not Scale then
		Session.Scope:Destroy()
		return
	end

	local FadeTween: Tween = TweenUtils.tween(
		Group,
		{ GroupTransparency = 1 },
		CLOSE_DURATION,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In
	)
	local ScaleTween: Tween = TweenUtils.tween(
		Scale,
		{ Scale = OPEN_SCALE },
		CLOSE_DURATION,
		Enum.EasingStyle.Back,
		Enum.EasingDirection.In
	)
	Session.Scope:Add(FadeTween)
	Session.Scope:Add(ScaleTween)
	Session.Scope:Connect(ScaleTween.Completed, function(): ()
		Session.Scope:Destroy()
	end)
	FadeTween:Play()
	ScaleTween:Play()
end

function PromptChoices:Open(Prompt: ProximityPrompt, Choices: { Choice }): ()
	if self._Prompt == Prompt and self._Session then
		self:Close(false)
		return
	end
	self:Close(true)

	local Adornee: Instance? = ResolveAdornee(Prompt)
	if not Adornee or #Choices == 0 then
		return
	end

	local Scope: any = Trove.new()
	local PromptWasEnabled: boolean = Prompt.Enabled
	local Height: number = (PANEL_PADDING * 2) + (#Choices * CHOICE_HEIGHT) + (math.max(#Choices - 1, 0) * CHOICE_GAP)
	local Billboard: BillboardGui = Instance.new("BillboardGui")
	Billboard.Name = "PromptChoices"
	Billboard.Adornee = Adornee
	Billboard.AlwaysOnTop = true
	Billboard.LightInfluence = 0
	Billboard.MaxDistance = Prompt.MaxActivationDistance + 3
	Billboard.Size = UDim2.fromOffset(PANEL_WIDTH, Height)
	Billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.3, 0)
	Billboard.ResetOnSpawn = false
	Billboard.Parent = self._PlayerGui
	Scope:Add(Billboard)
	Scope:Add(function(): ()
		if Prompt.Parent then
			Prompt:SetAttribute(PROMPT_OPEN_ATTRIBUTE, nil)
			Prompt.Enabled = PromptWasEnabled
		end
	end)

	local Group: CanvasGroup = Instance.new("CanvasGroup")
	Group.Name = "Choices"
	Group.AnchorPoint = Vector2.new(0.5, 0.5)
	Group.BackgroundColor3 = PANEL_COLOR
	Group.BackgroundTransparency = 0.04
	Group.BorderSizePixel = 0
	Group.GroupTransparency = 1
	Group.Position = UDim2.fromScale(0.5, 0.5)
	Group.Size = UDim2.fromScale(1, 1)
	Group.Parent = Billboard
	AddCorner(Group, CORNER_RADIUS + 2)
	AddStroke(Group, 2, 0)

	local Scale: UIScale = Instance.new("UIScale")
	Scale.Scale = OPEN_SCALE
	Scale.Parent = Group

	local Padding: UIPadding = Instance.new("UIPadding")
	Padding.PaddingBottom = UDim.new(0, PANEL_PADDING)
	Padding.PaddingLeft = UDim.new(0, PANEL_PADDING)
	Padding.PaddingRight = UDim.new(0, PANEL_PADDING)
	Padding.PaddingTop = UDim.new(0, PANEL_PADDING)
	Padding.Parent = Group

	local Layout: UIListLayout = Instance.new("UIListLayout")
	Layout.FillDirection = Enum.FillDirection.Vertical
	Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	Layout.Padding = UDim.new(0, CHOICE_GAP)
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.VerticalAlignment = Enum.VerticalAlignment.Center
	Layout.Parent = Group

	local Busy: boolean = false
	for Index: number, ChoiceValue: Choice in Choices do
		local Button: TextButton = BuildChoice(Group, ChoiceValue, Index)
		Scope:Connect(Button.Activated, function(): ()
			if Busy then
				return
			end
			Busy = true
			self:Close(false)
			task.spawn(ChoiceValue.Activate)
		end)
	end

	Scope:Add(function(): ()
		HudAnim.unbind_all(Billboard)
	end)
	Scope:Connect(Prompt.PromptHidden, function(): ()
		if Prompt.Enabled then
			self:Close(false)
		end
	end)
	Scope:Connect(Prompt.Destroying, function(): ()
		self:Close(true)
	end)
	Scope:Connect(Prompt:GetPropertyChangedSignal("Enabled"), function(): ()
		if not Prompt.Enabled and Prompt:GetAttribute(PROMPT_OPEN_ATTRIBUTE) ~= true then
			self:Close(false)
		end
	end)

	self._Prompt = Prompt
	self._Session = {
		Scope = Scope,
		Billboard = Billboard,
		Group = Group,
		Scale = Scale,
	}
	Prompt:SetAttribute(PROMPT_OPEN_ATTRIBUTE, true)
	Prompt.Enabled = false

	local FadeTween: Tween = TweenUtils.tween(
		Group,
		{ GroupTransparency = 0 },
		OPEN_DURATION,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)
	local ScaleTween: Tween = TweenUtils.tween(
		Scale,
		{ Scale = 1 },
		OPEN_DURATION,
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	)
	Scope:Add(FadeTween)
	Scope:Add(ScaleTween)
	FadeTween:Play()
	ScaleTween:Play()
end

function PromptChoices:Destroy(): ()
	self:Close(true)
end

return PromptChoices
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">UIRouter</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Framework: any = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Framework"))

export type EntryConfig = {
	Layer: string?,
	Exclusive: boolean?,
	SetOpen: (IsOpen: boolean, Animate: boolean) -> (),
}

type Entry = {
	Id: string,
	Layer: string,
	Exclusive: boolean,
	Open: boolean,
	Version: number,
	SetOpen: (IsOpen: boolean, Animate: boolean) -> (),
}

local DEFAULT_LAYER: string = "Modal"
local Entries: { [string]: Entry } = {}
local Initialized: boolean = false

local UIRouter = {}

local function UpdateDiagnostics(): ()
	local RegisteredCount: number = 0
	local OpenScreen: string? = nil
	for _Id: string, EntryValue: Entry in Entries do
		RegisteredCount += 1
		if EntryValue.Open then
			OpenScreen = EntryValue.Id
		end
	end
	script:SetAttribute("RegisteredCount", RegisteredCount)
	script:SetAttribute("OpenScreen", OpenScreen)
end

local function Apply(EntryValue: Entry, IsOpen: boolean, Animate: boolean): boolean
	if EntryValue.Open == IsOpen then
		return false
	end

	EntryValue.Open = IsOpen
	EntryValue.SetOpen(IsOpen, Animate)

	if IsOpen then
		Framework.RuntimeEvents.ScreenOpened:Fire(EntryValue.Id, EntryValue.Layer)
	else
		Framework.RuntimeEvents.ScreenClosed:Fire(EntryValue.Id, EntryValue.Layer)
	end
	UpdateDiagnostics()
	return true
end

local function CloseExclusiveSiblings(Target: Entry): ()
	if not Target.Exclusive then
		return
	end

	for Id: string, EntryValue: Entry in Entries do
		if Id ~= Target.Id and EntryValue.Open and EntryValue.Layer == Target.Layer then
			Apply(EntryValue, false, false)
		end
	end
end

function UIRouter.Init(): ()
	Initialized = true
	script:SetAttribute("Initialized", true)
	UpdateDiagnostics()
end

function UIRouter.Register(Id: string, Config: EntryConfig, InitiallyOpen: boolean?): (() -> ())
	assert(type(Id) == "string" and Id ~= "", "UIRouter.Register requires a non-empty id")
	assert(type(Config) == "table" and type(Config.SetOpen) == "function", "UIRouter.Register requires SetOpen")

	local Existing: Entry? = Entries[Id]
	if Existing then
		Existing.Layer = Config.Layer or Existing.Layer
		Existing.Exclusive = Config.Exclusive ~= false
		Existing.Open = if InitiallyOpen == nil then Existing.Open else InitiallyOpen
		Existing.Version += 1
		Existing.SetOpen = Config.SetOpen
		UpdateDiagnostics()
		local Version: number = Existing.Version
		return function(): ()
			local Current: Entry? = Entries[Id]
			if Current == Existing and Current.Version == Version then
				UIRouter.Unregister(Id)
			end
		end
	end

	local EntryValue: Entry = {
		Id = Id,
		Layer = Config.Layer or DEFAULT_LAYER,
		Exclusive = Config.Exclusive ~= false,
		Open = InitiallyOpen == true,
		Version = 1,
		SetOpen = Config.SetOpen,
	}
	Entries[Id] = EntryValue
	Framework.RuntimeEvents.ScreenRegistered:Fire(Id, EntryValue.Layer)
	UpdateDiagnostics()
	local Version: number = EntryValue.Version

	return function(): ()
		local Current: Entry? = Entries[Id]
		if Current == EntryValue and Current.Version == Version then
			UIRouter.Unregister(Id)
		end
	end
end

function UIRouter.Unregister(Id: string): ()
	local EntryValue: Entry? = Entries[Id]
	if not EntryValue then
		return
	end

	Entries[Id] = nil
	if EntryValue.Open then
		Framework.RuntimeEvents.ScreenClosed:Fire(EntryValue.Id, EntryValue.Layer)
	end
	UpdateDiagnostics()
end

function UIRouter.Open(Id: string, Animate: boolean?): boolean
	local EntryValue: Entry? = Entries[Id]
	if not EntryValue then
		return false
	end

	CloseExclusiveSiblings(EntryValue)
	Apply(EntryValue, true, Animate ~= false)
	return true
end

function UIRouter.Close(Id: string, Animate: boolean?): boolean
	local EntryValue: Entry? = Entries[Id]
	if not EntryValue then
		return false
	end

	Apply(EntryValue, false, Animate ~= false)
	return true
end

function UIRouter.Toggle(Id: string, Animate: boolean?): boolean
	if UIRouter.IsOpen(Id) then
		return UIRouter.Close(Id, Animate)
	end
	return UIRouter.Open(Id, Animate)
end

function UIRouter.Sync(Id: string, IsOpen: boolean): boolean
	local EntryValue: Entry? = Entries[Id]
	if not EntryValue then
		return false
	end

	if IsOpen then
		CloseExclusiveSiblings(EntryValue)
	end
	if EntryValue.Open == IsOpen then
		return true
	end

	EntryValue.Open = IsOpen
	if IsOpen then
		Framework.RuntimeEvents.ScreenOpened:Fire(EntryValue.Id, EntryValue.Layer)
	else
		Framework.RuntimeEvents.ScreenClosed:Fire(EntryValue.Id, EntryValue.Layer)
	end
	UpdateDiagnostics()
	return true
end

function UIRouter.IsRegistered(Id: string): boolean
	return Entries[Id] ~= nil
end

function UIRouter.IsOpen(Id: string): boolean
	local EntryValue: Entry? = Entries[Id]
	return EntryValue ~= nil and EntryValue.Open
end

function UIRouter.GetOpen(Layer: string?): string?
	for Id: string, EntryValue: Entry in Entries do
		if EntryValue.Open and (Layer == nil or EntryValue.Layer == Layer) then
			return Id
		end
	end
	return nil
end

function UIRouter.CloseLayer(Layer: string, Animate: boolean?): ()
	for _Id: string, EntryValue: Entry in Entries do
		if EntryValue.Open and EntryValue.Layer == Layer then
			Apply(EntryValue, false, Animate ~= false)
		end
	end
end

function UIRouter.Destroy(): ()
	if not Initialized and next(Entries) == nil then
		return
	end

	for Id: string in table.clone(Entries) do
		UIRouter.Unregister(Id)
	end
	Initialized = false
	script:SetAttribute("Initialized", false)
	UpdateDiagnostics()
end

return UIRouter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">UIRuntime</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players: Players = game:GetService("Players")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))
local HudAnim: any = require(Modules:WaitForChild("Libraries"):WaitForChild("HudAnim"))
local OutlinedText: any = require(script.Parent:WaitForChild("OutlinedText"))

local UIRouter: any = require(
	Modules
		:WaitForChild("Client")
		:WaitForChild("Hud")
		:WaitForChild("UIRouter")
)

local IGNORE_HUD_ANIM_ATTRIBUTE: string = "IgnoreHudAnim"

local UIRuntime = {
	Name = "UIRuntime",
	Trove = nil :: any,
	PlayerGui = nil :: PlayerGui?,
}

local function HasTrueAttribute(InstanceValue: Instance, AttributeName: string): boolean
	local Current: Instance? = InstanceValue
	while Current do
		if Current:GetAttribute(AttributeName) == true then
			return true
		end
		Current = Current.Parent
	end
	return false
end

local function SetupInterface(InstanceValue: Instance): ()
	local IsScreenGui: boolean = InstanceValue:IsA("ScreenGui")
	if IsScreenGui then
		OutlinedText.bind_all(InstanceValue)
	else
		OutlinedText.bind(InstanceValue)
	end

	if HasTrueAttribute(InstanceValue, IGNORE_HUD_ANIM_ATTRIBUTE) then
		return
	end

	if IsScreenGui then
		HudAnim.apply_defaults_to_buttons(InstanceValue)
		HudAnim.bind_all(InstanceValue)
		return
	end

	if InstanceValue:IsA("GuiButton") then
		InstanceValue:SetAttribute("UIAnim", true)
		HudAnim.bind(InstanceValue)
		return
	end

	if InstanceValue:IsA("GuiObject") then
		HudAnim.bind(InstanceValue)
	end
end

function UIRuntime:Init(): ()
	UIRouter.Init()
end

function UIRuntime:Start(): ()
	if self.Trove then
		return
	end

	local Player: Player = Players.LocalPlayer
	local PlayerGui: PlayerGui = Player:WaitForChild("PlayerGui") :: PlayerGui
	local RuntimeTrove: any = Trove.new()
	self.Trove = RuntimeTrove
	self.PlayerGui = PlayerGui
	script:SetAttribute("Started", true)
	RuntimeTrove:Connect(PlayerGui.DescendantAdded, SetupInterface)

	for _Index: number, Gui: Instance in PlayerGui:GetChildren() do
		SetupInterface(Gui)
	end
end

function UIRuntime:Destroy(): ()
	script:SetAttribute("Started", false)
	local PlayerGui: PlayerGui? = self.PlayerGui
	self.PlayerGui = nil
	if PlayerGui then
		HudAnim.unbind_all(PlayerGui)
		OutlinedText.unbind_all(PlayerGui)
	end

	if self.Trove then
		self.Trove:Destroy()
		self.Trove = nil
	end
	UIRouter.Destroy()
end

return UIRuntime
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="89">
          <Properties>
            <string name="Name">Quest</string>
          </Properties>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">QuestClient</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Libraries = Modules:WaitForChild("Libraries")
local Utility = Modules:WaitForChild("Utility")

local DataUtility = require(Utility:WaitForChild("DataUtility"))
local Net = require(Libraries:WaitForChild("Net"))

local QuestClient = {}

function QuestClient.GetDailyQuestState()
	return DataUtility.client.get("Quests.Daily")
end

function QuestClient.BindDailyQuestChanged(fn)
	return DataUtility.client.bind("Quests.Daily", fn)
end

function QuestClient.ClaimDailyQuestReward()
	return Net.Function.ClaimDailyQuest:Call()
end

return QuestClient
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="91">
        <Properties>
          <string name="Name">Dictionary</string>
        </Properties>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">SoapCleaningDictionary</string>
            <string name="Source"><![CDATA[------------------//SERVICES

------------------//VARIABLES
local SoapCleaningDictionary = {
	InstructionText = "Hold and drag the mouse over the horse",
	StageInstructionFormat = "Scrub the %s",
	RinseInstructionText = "Move the shower across the horse",
	CompleteText = "All clean",
	FinishingText = "Horse cleaned",
	CancelKeys = {
		Enum.KeyCode.Escape,
		Enum.KeyCode.Q,
	},
	StageOrder = {
		"Right",
		"Front",
		"Left",
		"Back",
		"Top",
	},
	StageLabels = {
		Right = "Right side",
		Front = "Front",
		Left = "Left side",
		Back = "Back",
		Top = "Top",
	},
	StageProgressGoal = 5,
	SideThreshold = 0.12,
	MinimumScrubDistance = 0.05,
	MinimumMouseDragDistance = 1,
	ProgressStepDuration = 0.2,
	ProgressGainPerStep = 1,
	BubbleSpawnDistance = 0.22,
	BubbleCountMin = 1,
	BubbleCountMax = 1,
	BubbleSpread = 0.78,
	BubbleSurfaceOffsetMin = -0.18,
	BubbleSurfaceOffsetMax = -0.08,
