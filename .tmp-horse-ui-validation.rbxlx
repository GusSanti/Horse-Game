              <Item class="ModuleScript" referent="104">
                <Properties>
                  <string name="Name">GroundProbe</string>
                  <string name="Source"><![CDATA[--!strict

export type Sample = {
	GroundY: number?,
	Pitch: number,
	Roll: number,
	ObstacleSpeedAlpha: number,
}

export type Config = {
	GroundProbeHeight: number?,
	GroundProbeDistance: number?,
	TerrainProbeSpacing: number?,
	MaxTerrainPitchDegrees: number?,
	MaxTerrainRollDegrees: number?,
	HorseProbeIntervalSeconds: number?,
	HorseObstacleProbeDistance: number?,
	HorseObstacleProbeMinHeight: number?,
	HorseObstacleProbeMaxHeight: number?,
	HorseObstacleStopDistance: number?,
}

export type Probe = {
	WorldRoot: WorldRoot,
	Config: Config,
	Params: RaycastParams,
	Elapsed: number,
	HasSample: boolean,
	Sample: Sample,
	SetIgnore: (self: Probe, IgnoreList: { Instance }) -> (),
	Update: (self: Probe, DeltaTime: number, Position: Vector3, Yaw: number, GroundOffset: number) -> Sample,
	Reset: (self: Probe) -> (),
}

local GroundProbe = {}
GroundProbe.__index = GroundProbe

local function CastGround(Self: Probe, Position: Vector3): number?
	local ProbeHeight: number = math.max(tonumber(Self.Config.GroundProbeHeight) or 24, 1)
	local ProbeDistance: number = math.max(tonumber(Self.Config.GroundProbeDistance) or 64, 1)
	local Origin: Vector3 = Position + Vector3.new(0, ProbeHeight, 0)
	local Result: RaycastResult? = Self.WorldRoot:Raycast(
		Origin,
		Vector3.new(0, -(ProbeHeight + ProbeDistance), 0),
		Self.Params
	)
	return if Result then Result.Position.Y else nil
end

local function ResolveTerrainAngles(Self: Probe, Position: Vector3, Yaw: number): (number, number)
	local Spacing: number = math.max(tonumber(Self.Config.TerrainProbeSpacing) or 3, 0.5)
	local Orientation: CFrame = CFrame.Angles(0, Yaw, 0)
	local Forward: Vector3 = Orientation.LookVector
	local Right: Vector3 = Orientation.RightVector
	local FrontY: number? = CastGround(Self, Position + (Forward * Spacing))
	local BackY: number? = CastGround(Self, Position - (Forward * Spacing))
	local RightY: number? = CastGround(Self, Position + (Right * Spacing))
	local LeftY: number? = CastGround(Self, Position - (Right * Spacing))
	local Span: number = Spacing * 2

	local Pitch: number = 0
	if FrontY and BackY then
		local MaxPitch: number = math.rad(math.max(tonumber(Self.Config.MaxTerrainPitchDegrees) or 22, 0))
		Pitch = math.clamp(math.atan2(FrontY - BackY, Span), -MaxPitch, MaxPitch)
	end

	local Roll: number = 0
	if RightY and LeftY then
		local MaxRoll: number = math.rad(math.max(tonumber(Self.Config.MaxTerrainRollDegrees) or 12, 0))
		Roll = math.clamp(math.atan2(RightY - LeftY, Span), -MaxRoll, MaxRoll)
	end
	return Pitch, Roll
end

local function CastObstacle(
	Self: Probe,
	Position: Vector3,
	Direction: Vector3,
	Height: number,
	Distance: number
): RaycastResult?
	return Self.WorldRoot:Raycast(
		Position + Vector3.new(0, Height, 0),
		Direction * Distance,
		Self.Params
	)
end

local function ResolveObstacleSpeedAlpha(
	Self: Probe,
	Position: Vector3,
	Direction: Vector3,
	GroundOffset: number
): number
	local Distance: number = math.max(tonumber(Self.Config.HorseObstacleProbeDistance) or 8, 1)
	local StopDistance: number = math.clamp(tonumber(Self.Config.HorseObstacleStopDistance) or 2.25, 0, Distance)
	local MinHeight: number = math.max(tonumber(Self.Config.HorseObstacleProbeMinHeight) or 1.25, 0)
	local MaxHeight: number = math.max(tonumber(Self.Config.HorseObstacleProbeMaxHeight) or 3.75, MinHeight)
	local HeightScale: number = math.clamp(GroundOffset * 0.4, 0, 3)
	local LowResult: RaycastResult? = CastObstacle(Self, Position, Direction, MinHeight + HeightScale, Distance)
	local HighResult: RaycastResult? = CastObstacle(Self, Position, Direction, MaxHeight + HeightScale, Distance)
	local Result: RaycastResult? = LowResult or HighResult
	if not Result or Result.Normal.Y > 0.72 then
		return 1
	end

	return math.clamp((Result.Distance - StopDistance) / math.max(Distance - StopDistance, 0.01), 0, 1)
end

function GroundProbe.new(WorldRootValue: WorldRoot, ConfigValue: Config): Probe
	local Params: RaycastParams = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.IgnoreWater = false
	return setmetatable({
		WorldRoot = WorldRootValue,
		Config = ConfigValue,
		Params = Params,
		Elapsed = 0,
		HasSample = false,
		Sample = {
			GroundY = nil,
			Pitch = 0,
			Roll = 0,
			ObstacleSpeedAlpha = 1,
		},
	}, GroundProbe) :: any
end

function GroundProbe.SetIgnore(Self: Probe, IgnoreList: { Instance }): ()
	Self.Params.FilterDescendantsInstances = IgnoreList
end

function GroundProbe.Update(
	Self: Probe,
	DeltaTime: number,
	Position: Vector3,
	Yaw: number,
	GroundOffset: number
): Sample
	Self.Elapsed += math.max(DeltaTime, 0)
	local Interval: number = math.max(tonumber(Self.Config.HorseProbeIntervalSeconds) or 0.05, 0.016)
	if Self.HasSample and Self.Elapsed < Interval then
		return Self.Sample
	end
	Self.Elapsed = 0
	Self.HasSample = true

	local Direction: Vector3 = CFrame.Angles(0, Yaw, 0).LookVector
	local Pitch: number, Roll: number = ResolveTerrainAngles(Self, Position, Yaw)
	Self.Sample.GroundY = CastGround(Self, Position)
	Self.Sample.Pitch = Pitch
	Self.Sample.Roll = Roll
	Self.Sample.ObstacleSpeedAlpha = ResolveObstacleSpeedAlpha(Self, Position, Direction, GroundOffset)
	return Self.Sample
end

function GroundProbe.Reset(Self: Probe): ()
	Self.Elapsed = 0
	Self.HasSample = false
	Self.Sample.GroundY = nil
	Self.Sample.Pitch = 0
	Self.Sample.Roll = 0
	Self.Sample.ObstacleSpeedAlpha = 1
	Self.Params.FilterDescendantsInstances = {}
end

return table.freeze(GroundProbe)
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="105">
                <Properties>
                  <string name="Name">StateMachine</string>
                  <string name="Source"><![CDATA[--!strict

export type Mode = "Idle" | "Gait" | "Trot" | "Gallop" | "Backward" | "Rear"

export type State = {
	Speed: number,
	Mode: Mode,
	ForwardWasDown: boolean,
	BackwardWasDown: boolean,
	ReverseBrakeHeld: boolean,
	LastForwardPressAt: number,
	ForwardReleasedAt: number,
	BoostEndsAt: number,
	RearEndsAt: number,
	RearCooldownEndsAt: number,
}

export type Input = {
	Forward: number,
	Backward: number,
	Sprinting: boolean,
	Stopping: boolean?,
	ObstacleSpeedAlpha: number?,
}

export type Movement = {
	WalkSpeed: number?,
	TrotSpeed: number?,
	CanterSpeed: number?,
	SprintSpeed: number?,
	Acceleration: number?,
}

export type Config = {
	HorseForwardAccelerationSeconds: number?,
	HorseAccelerationBaseStat: number?,
	HorseBrakePerSecond: number?,
	HorseReverseAccelerationPerSecond: number?,
	HorseReverseCoastDragPerSecond: number?,
	HorseReverseStopEpsilon: number?,
	HorseCoastDragPerSecond: number?,
	HorseDismountBrakePerSecond: number?,
	HorseDoubleTapWindowSeconds: number?,
	HorseDoubleTapMinReleaseSeconds: number?,
	HorseDoubleTapBoostSeconds: number?,
	HorseSprintAccelerationMultiplier: number?,
	HorseBackwardSpeedMultiplier: number?,
	HorseMovementStopEpsilon: number?,
	HorseRearDurationSeconds: number?,
	HorseRearCooldownSeconds: number?,
	HorseRearMaxStartSpeed: number?,
}

local DEFAULT_WALK_SPEED: number = 14
local DEFAULT_TROT_SPEED: number = 18
local DEFAULT_CANTER_SPEED: number = 22
local DEFAULT_SPRINT_SPEED: number = 26
local DEFAULT_ACCELERATION_STAT: number = 0.8
local INPUT_DEADZONE: number = 0.05

local StateMachine = {}

local function MoveTowards(Current: number, Target: number, MaxDelta: number): number
	if math.abs(Target - Current) <= MaxDelta then
		return Target
	end
	return Current + (if Target > Current then MaxDelta else -MaxDelta)
end

local function ResolveSpeeds(MovementValue: Movement): (number, number, number, number)
	local WalkSpeed: number = math.max(tonumber(MovementValue.WalkSpeed) or DEFAULT_WALK_SPEED, 0)
	local TrotSpeed: number = math.max(tonumber(MovementValue.TrotSpeed) or DEFAULT_TROT_SPEED, WalkSpeed)
	local CanterSpeed: number = math.max(tonumber(MovementValue.CanterSpeed) or DEFAULT_CANTER_SPEED, TrotSpeed)
	local SprintSpeed: number = math.max(tonumber(MovementValue.SprintSpeed) or DEFAULT_SPRINT_SPEED, CanterSpeed)
	return WalkSpeed, TrotSpeed, CanterSpeed, SprintSpeed
end

function StateMachine.Create(): State
	return {
		Speed = 0,
		Mode = "Idle",
		ForwardWasDown = false,
		BackwardWasDown = false,
		ReverseBrakeHeld = false,
		LastForwardPressAt = -math.huge,
		ForwardReleasedAt = -math.huge,
		BoostEndsAt = 0,
		RearEndsAt = 0,
		RearCooldownEndsAt = 0,
	}
end

function StateMachine.ClassifySpeed(Speed: number, MovementValue: Movement, RearActive: boolean?): Mode
	if RearActive == true then
		return "Rear"
	end

	local WalkSpeed: number, _TrotSpeed: number, CanterSpeed: number = ResolveSpeeds(MovementValue)
	local StopEpsilon: number = 0.25
	if Speed < -StopEpsilon then
		return "Backward"
	end
	if Speed <= StopEpsilon then
		return "Idle"
	end
	if Speed <= WalkSpeed then
		return "Gait"
	end
	if Speed <= CanterSpeed then
		return "Trot"
	end
	return "Gallop"
end

function StateMachine.IsRearActive(StateValue: State, Now: number): boolean
	return StateValue.RearEndsAt > Now
end

function StateMachine.RequestRear(StateValue: State, ConfigValue: Config, Now: number): boolean
	local MaxStartSpeed: number = math.max(tonumber(ConfigValue.HorseRearMaxStartSpeed) or 0.75, 0)
	if math.abs(StateValue.Speed) > MaxStartSpeed or Now < StateValue.RearCooldownEndsAt then
		return false
	end

	local Duration: number = math.max(tonumber(ConfigValue.HorseRearDurationSeconds) or 1.15, 0.1)
	local Cooldown: number = math.max(tonumber(ConfigValue.HorseRearCooldownSeconds) or 1.75, Duration)
	StateValue.Speed = 0
	StateValue.RearEndsAt = Now + Duration
	StateValue.RearCooldownEndsAt = Now + Cooldown
	StateValue.Mode = "Rear"
	return true
end

local function ApplyForwardPress(
	StateValue: State,
	MovementValue: Movement,
	ConfigValue: Config,
	Now: number
): ()
	local DoubleTapWindow: number = math.max(tonumber(ConfigValue.HorseDoubleTapWindowSeconds) or 0.28, 0)
	local MinReleaseSeconds: number = math.max(
		tonumber(ConfigValue.HorseDoubleTapMinReleaseSeconds) or 0.04,
		0
	)
	local ReleaseSeconds: number = Now - StateValue.ForwardReleasedAt
	if Now - StateValue.LastForwardPressAt <= DoubleTapWindow and ReleaseSeconds >= MinReleaseSeconds then
		local _WalkSpeed: number, _TrotSpeed: number, CanterSpeed: number = ResolveSpeeds(MovementValue)
		StateValue.Speed = math.max(StateValue.Speed, CanterSpeed + 0.01)
		StateValue.BoostEndsAt = Now + math.max(tonumber(ConfigValue.HorseDoubleTapBoostSeconds) or 0.4, 0)
	end
	StateValue.LastForwardPressAt = Now
end

local function GetForwardAcceleration(MovementValue: Movement, ConfigValue: Config): number
	local _WalkSpeed: number, _TrotSpeed: number, _CanterSpeed: number, SprintSpeed: number = ResolveSpeeds(MovementValue)
	local AccelerationSeconds: number = math.max(tonumber(ConfigValue.HorseForwardAccelerationSeconds) or 3, 0.1)
	local BaseStat: number = math.max(tonumber(ConfigValue.HorseAccelerationBaseStat) or DEFAULT_ACCELERATION_STAT, 0.01)
	local AccelerationStat: number = math.max(tonumber(MovementValue.Acceleration) or BaseStat, 0)
	return (SprintSpeed / AccelerationSeconds) * math.clamp(AccelerationStat / BaseStat, 0.5, 1.75)
end

function StateMachine.Step(
	StateValue: State,
	InputValue: Input,
	MovementValue: Movement,
	ConfigValue: Config,
	DeltaTime: number,
	Now: number
): State
	local ClampedDelta: number = math.clamp(DeltaTime, 0, 0.1)
	local Forward: number = math.clamp(InputValue.Forward, 0, 1)
	local Backward: number = math.clamp(InputValue.Backward, 0, 1)
	local ForwardDown: boolean = Forward > INPUT_DEADZONE
	local BackwardDown: boolean = Backward > INPUT_DEADZONE
	local StopEpsilon: number = math.max(tonumber(ConfigValue.HorseMovementStopEpsilon) or 0.01, 0)

	if StateMachine.IsRearActive(StateValue, Now) then
		StateValue.Speed = 0
		StateValue.Mode = "Rear"
		StateValue.ForwardWasDown = ForwardDown
		StateValue.BackwardWasDown = BackwardDown
		StateValue.ReverseBrakeHeld = false
		return StateValue
	end

	if not ForwardDown and StateValue.ForwardWasDown then
		StateValue.ForwardReleasedAt = Now
	elseif ForwardDown and not StateValue.ForwardWasDown then
		ApplyForwardPress(StateValue, MovementValue, ConfigValue, Now)
	end
	StateValue.ForwardWasDown = ForwardDown

	if BackwardDown and not StateValue.BackwardWasDown then
		StateValue.ReverseBrakeHeld = StateValue.Speed > StopEpsilon
	elseif not BackwardDown then
		StateValue.ReverseBrakeHeld = false
	end
	StateValue.BackwardWasDown = BackwardDown

	local _WalkSpeed: number, _TrotSpeed: number, _CanterSpeed: number, SprintSpeed: number = ResolveSpeeds(MovementValue)
	local Speed: number = StateValue.Speed
	if InputValue.Stopping == true then
		local DismountBrakeRate: number = math.max(
			tonumber(ConfigValue.HorseDismountBrakePerSecond) or 14,
			0
		)
		Speed = MoveTowards(Speed, 0, DismountBrakeRate * ClampedDelta)
	elseif ForwardDown then
		local Acceleration: number = GetForwardAcceleration(MovementValue, ConfigValue)
		if InputValue.Sprinting or Now < StateValue.BoostEndsAt then
			Acceleration *= math.max(tonumber(ConfigValue.HorseSprintAccelerationMultiplier) or 1.45, 1)
		end
		Speed = MoveTowards(Speed, SprintSpeed, Acceleration * Forward * ClampedDelta)
	elseif BackwardDown then
		if Speed > 0 then
			local BrakeRate: number = math.max(tonumber(ConfigValue.HorseBrakePerSecond) or 20, 0)
			Speed = MoveTowards(Speed, 0, BrakeRate * Backward * ClampedDelta)
		elseif not StateValue.ReverseBrakeHeld then
			local BackwardMultiplier: number = math.clamp(
				tonumber(ConfigValue.HorseBackwardSpeedMultiplier) or 0.48,
				0,
				1
			)
			local ReverseRate: number = math.max(tonumber(ConfigValue.HorseReverseAccelerationPerSecond) or 8, 0)
			Speed = MoveTowards(Speed, -(SprintSpeed * BackwardMultiplier), ReverseRate * Backward * ClampedDelta)
		end
	else
		local CoastDrag: number = if Speed < 0
			then math.max(tonumber(ConfigValue.HorseReverseCoastDragPerSecond) or 10, 0)
			else math.max(tonumber(ConfigValue.HorseCoastDragPerSecond) or 0, 0)
		Speed = MoveTowards(Speed, 0, CoastDrag * ClampedDelta)
	end

	local ObstacleSpeedAlpha: number = math.clamp(tonumber(InputValue.ObstacleSpeedAlpha) or 1, 0, 1)
	if Speed > SprintSpeed * ObstacleSpeedAlpha then
		local BrakeRate: number = math.max(tonumber(ConfigValue.HorseBrakePerSecond) or 20, 0)
		Speed = MoveTowards(Speed, SprintSpeed * ObstacleSpeedAlpha, BrakeRate * ClampedDelta)
	end

	local ActiveStopEpsilon: number = if Speed < 0
		then math.max(tonumber(ConfigValue.HorseReverseStopEpsilon) or 0.15, StopEpsilon)
		else StopEpsilon
	if math.abs(Speed) <= ActiveStopEpsilon then
		Speed = 0
	end
	StateValue.Speed = math.clamp(Speed, -(SprintSpeed), SprintSpeed)
	StateValue.Mode = StateMachine.ClassifySpeed(StateValue.Speed, MovementValue, false)
	return StateValue
end

function StateMachine.ReconcileSpeed(
	StateValue: State,
	AuthoritativeSpeed: number,
	Threshold: number,
	BlendAlpha: number
): boolean
	if math.abs(StateValue.Speed - AuthoritativeSpeed) <= math.max(Threshold, 0) then
		return false
	end
	StateValue.Speed += (AuthoritativeSpeed - StateValue.Speed) * math.clamp(BlendAlpha, 0, 1)
	return true
end

return table.freeze(StateMachine)
]]></string>
                </Properties>
              </Item>
            </Item>
          </Item>
