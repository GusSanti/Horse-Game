        <Item class="ModuleScript" referent="324">
          <Properties>
            <string name="Name">RuntimeManifest_Test</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local RuntimeManifest: any = require(ReplicatedStorage.Modules.Framework.RuntimeManifest)

return function(t: any): ()
	local function ValidateEntries(Entries: { any }): ()
		local Names: { [string]: boolean } = {}
		for _Index: number, Definition: any in Entries do
			t.expect.truthy(type(Definition.Name) == "string" and Definition.Name ~= "")
			t.expect.truthy(type(Definition.Path) == "table" and #Definition.Path > 0)
			t.expect.falsy(Names[Definition.Name])
			Names[Definition.Name] = true
		end
	end

	-- Every runtime entry has a stable unique name and a resolvable path contract.
	t.test("defines valid server entrypoints", function(): ()
		ValidateEntries(RuntimeManifest.Server)
	end)

	-- Client startup uses the same explicit manifest contract as server startup.
	t.test("defines valid client entrypoints", function(): ()
		ValidateEntries(RuntimeManifest.Client)
	end)

	-- The server no longer depends on cloned scripts; components own its lifecycle.
	t.test("has no legacy server entrypoints", function(): ()
		t.expect.equal(#RuntimeManifest.Server, 0)
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="325">
          <Properties>
            <string name="Name">Signal_Test</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal: any = require(ReplicatedStorage.Modules.Framework.Signal)

return function(t: any): ()
	-- Connected listeners receive the values supplied by the owner.
	t.test("delivers fired values", function(): ()
		local Event: any = Signal.new()
		local Received: string? = nil
		Event:Connect(function(Value: string): ()
			Received = Value
		end)

		Event:Fire("ready")
		t.expect.equal(Received, "ready")
		Event:Destroy()
	end)

	-- A disconnected listener releases ownership and receives no later events.
	t.test("disconnects listeners", function(): ()
		local Event: any = Signal.new()
		local Count: number = 0
		local Connection: any = Event:Connect(function(): ()
			Count += 1
		end)

		Event:Fire()
		Connection:Disconnect()
		Event:Fire()
		t.expect.equal(Count, 1)
		Event:Destroy()
	end)

	-- Once listeners remove themselves before invoking user code.
	t.test("fires once listeners once", function(): ()
		local Event: any = Signal.new()
		local Count: number = 0
		Event:Once(function(): ()
			Count += 1
		end)

		Event:Fire()
		Event:Fire()
		t.expect.equal(Count, 1)
		Event:Destroy()
	end)

	-- Destroy is idempotent and rejects new resource ownership.
	t.test("rejects connections after destroy", function(): ()
		local Event: any = Signal.new()
		Event:Destroy()
		Event:Destroy()
		t.expect.throws(function(): ()
			Event:Connect(function(): () end)
		end)
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="326">
          <Properties>
            <string name="Name">UIRouter_Test</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIRouter: any = require(ReplicatedStorage.Modules.Client.Hud.UIRouter)

return function(t: any): ()
	t.test("opens one exclusive modal at a time", function(): ()
		UIRouter.Destroy()
		UIRouter.Init()
		local Changes: { string } = {}

		UIRouter.Register("Inventory", {
			SetOpen = function(IsOpen: boolean, Animate: boolean): ()
				table.insert(Changes, `Inventory:{tostring(IsOpen)}:{tostring(Animate)}`)
			end,
		}, false)
		UIRouter.Register("Shop", {
			SetOpen = function(IsOpen: boolean, Animate: boolean): ()
				table.insert(Changes, `Shop:{tostring(IsOpen)}:{tostring(Animate)}`)
			end,
		}, false)

		UIRouter.Open("Inventory", true)
		UIRouter.Open("Shop", true)

		t.expect.equal(table.concat(Changes, ","), "Inventory:true:true,Inventory:false:false,Shop:true:true")
		t.expect.falsy(UIRouter.IsOpen("Inventory"))
		t.expect.truthy(UIRouter.IsOpen("Shop"))
		UIRouter.Destroy()
	end)

	t.test("allows non-exclusive views to coexist", function(): ()
		UIRouter.Destroy()
		UIRouter.Init()
		local function IgnoreChange(_IsOpen: boolean, _Animate: boolean): () end

		UIRouter.Register("FirstToast", {
			Layer = "Notification",
			Exclusive = false,
			SetOpen = IgnoreChange,
		}, false)
		UIRouter.Register("SecondToast", {
			Layer = "Notification",
			Exclusive = false,
			SetOpen = IgnoreChange,
		}, false)

		UIRouter.Open("FirstToast", false)
		UIRouter.Open("SecondToast", false)
		t.expect.truthy(UIRouter.IsOpen("FirstToast"))
		t.expect.truthy(UIRouter.IsOpen("SecondToast"))
		UIRouter.Destroy()
	end)

	t.test("synchronizes visibility changed by legacy code", function(): ()
		UIRouter.Destroy()
		UIRouter.Init()
		local InventoryClosed: boolean = false

		UIRouter.Register("Inventory", {
			SetOpen = function(IsOpen: boolean, Animate: boolean): ()
				if not IsOpen and not Animate then
					InventoryClosed = true
				end
			end,
		}, false)
		UIRouter.Register("Shop", {
			SetOpen = function(_IsOpen: boolean, _Animate: boolean): () end,
		}, false)

		UIRouter.Open("Inventory", false)
		UIRouter.Sync("Shop", true)
		t.expect.truthy(InventoryClosed)
		t.expect.falsy(UIRouter.IsOpen("Inventory"))
		t.expect.truthy(UIRouter.IsOpen("Shop"))
		UIRouter.Destroy()
	end)

	t.test("does not let stale cleanup unregister a replacement", function(): ()
		UIRouter.Destroy()
		UIRouter.Init()
		local FirstCleanup: () -> () = UIRouter.Register("Stable", {
			SetOpen = function(_IsOpen: boolean, _Animate: boolean): () end,
		}, false)
		local SecondCleanup: () -> () = UIRouter.Register("Stable", {
			SetOpen = function(_IsOpen: boolean, _Animate: boolean): () end,
		}, false)

		FirstCleanup()
		t.expect.truthy(UIRouter.IsRegistered("Stable"))
		SecondCleanup()
		t.expect.falsy(UIRouter.IsRegistered("Stable"))
		UIRouter.Destroy()
	end)
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="327">
        <Properties>
          <string name="Name">RunUnitTest</string>
          <string name="Source"><![CDATA[--!strict

local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local function Format(Value: any): string
	return if type(Value) == "string" then string.format("%q", Value) else tostring(Value)
end

local Expect = {}

function Expect.equal(Actual: any, Expected: any): ()
	if Actual ~= Expected then
		error(`expected {Format(Expected)}, got {Format(Actual)}`, 2)
	end
end

function Expect.truthy(Value: any): ()
	if not Value then
		error(`expected truthy, got {Format(Value)}`, 2)
	end
end

function Expect.falsy(Value: any): ()
	if Value then
		error(`expected falsy, got {Format(Value)}`, 2)
	end
end

function Expect.throws(Callback: () -> ()): string
	local Success: boolean, ErrorValue: any = pcall(Callback)
	if Success then
		error("expected the callback to throw", 2)
	end
	return tostring(ErrorValue)
end

return function(Filter: string?): { Run: number, Passed: number, Failed: number }
	local Totals = {
		Run = 0,
		Passed = 0,
		Failed = 0,
	}

	local UnitTestFolder: Folder = ServerStorage:WaitForChild("UnitTest") :: Folder
	local Cases: Folder = UnitTestFolder:WaitForChild("Cases") :: Folder
	for _Index: number, CaseModule: Instance in Cases:GetChildren() do
		if not CaseModule:IsA("ModuleScript") or (Filter and not string.find(CaseModule.Name, Filter, 1, true)) then
			continue
		end

		local CaseBuilder: any = require(CaseModule)
		local Context: any = {
			expect = Expect,
		}

		function Context.test(Name: string, Callback: () -> ()): ()
			Totals.Run += 1
			local Success: boolean, ErrorValue: any = pcall(Callback)
			if Success then
				Totals.Passed += 1
				print(`[PASS] {CaseModule.Name} > {Name}`)
			else
				Totals.Failed += 1
				warn(`[FAIL] {CaseModule.Name} > {Name} | {tostring(ErrorValue)}`)
			end
		end

		CaseBuilder(Context)
	end

	print(`[SUMMARY] {Totals.Run} run, {Totals.Passed} passed, {Totals.Failed} failed`)
	return Totals
end
]]></string>
        </Properties>
      </Item>
    </Item>
