}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="159">
          <Properties>
            <string name="Name">Ui</string>
          </Properties>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">BaseSignConfig</string>
              <string name="Source"><![CDATA[local BaseSignConfig = {
