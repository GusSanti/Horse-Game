  </Item>
  <Item class="ServerScriptService" referent="231">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="232">
      <Properties>
        <string name="Name">Components</string>
      </Properties>
      <Item class="ModuleScript" referent="233">
        <Properties>
          <string name="Name">AdminRuntime</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))
local AdminAccessService: any = require(
	ServerStorage:WaitForChild("Modules"):WaitForChild("Admin"):WaitForChild("AdminAccessService")
)
local Commands: any = require(script.Commands)
local Operations: any = require(script.Operations)

local AdminRuntime = {
	Name = "AdminRuntime",
	Trove = nil :: any,
}

function AdminRuntime:Init(): ()
	if self.Trove then
		return
	end

	self.Trove = Trove.new()
	Operations.Bind(self.Trove)
	Commands.Bind(self.Trove)
	self.Trove:Connect(Framework.RuntimeEvents.PlayerAdded, function(Player: Player): ()
		task.spawn(AdminAccessService.ApplyAccessAttributes, Player)
	end)
end

function AdminRuntime:Destroy(): ()
	if self.Trove then
		self.Trove:Destroy()
		self.Trove = nil
	end
end

return AdminRuntime
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="234">
          <Properties>
            <string name="Name">Commands</string>
            <string name="Source"><![CDATA[--!strict

local Players: Players = game:GetService("Players")
local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local DataUtility: any = require(Modules:WaitForChild("Utility"):WaitForChild("DataUtility"))
local ToolItemCatalog: any = require(Modules:WaitForChild("GameData"):WaitForChild("ToolItemCatalog"))
local AdminAccessService: any = require(
	ServerStorage:WaitForChild("Modules"):WaitForChild("Admin"):WaitForChild("AdminAccessService")
)
local InventoryService: any = require(
	ServerStorage:WaitForChild("Modules"):WaitForChild("Inventory"):WaitForChild("InventoryServer")
)

local Commands = {}

local COMMAND_NAME = "!setcoins"
local EAT_COMMAND_NAME = "!eat"
local MAX_HORSESHOES = 1000000000
local randomGenerator = Random.new()

local function normalize(value: string): string
	return string.lower(string.gsub(value, "^%s*(.-)%s*$", "%1"))
end

local function resolve_target_player(requestingPlayer: Player, playerName: string): Player?
	local normalizedName = normalize(playerName)
	if normalizedName == "me" then
		return requestingPlayer
	end

	for _, player: Player in Players:GetPlayers() do
		if normalize(player.Name) == normalizedName then
			return player
		end
	end

	local matches: { Player } = {}
	for _, player: Player in Players:GetPlayers() do
		if string.sub(normalize(player.Name), 1, #normalizedName) == normalizedName then
			matches[#matches + 1] = player
		end
	end

	return if #matches == 1 then matches[1] else nil
end

local function parse_set_coins_command(message: string): (string?, number?)
	local targetName, amountText = string.match(message, "^%s*!setcoins%s+(%S+)%s+(%S+)%s*$")
	if not targetName or not amountText then
		return nil, nil
	end

	local amount = tonumber(amountText)
	if not amount or amount ~= math.floor(amount) or amount < 0 or amount > MAX_HORSESHOES then
		return nil, nil
	end

	return targetName, amount
end

local function grant_random_food(player: Player): ()
	local foodDefinitions = ToolItemCatalog.GetItemsByToolCategory("Food")
	if #foodDefinitions == 0 then
		warn(("[AdminCommands] No food definitions are available for %s"):format(EAT_COMMAND_NAME))
		return
	end

	local foodDefinition = foodDefinitions[randomGenerator:NextInteger(1, #foodDefinitions)]
	local updatedCount = InventoryService.AddItemCount(player, foodDefinition, 1)
	print(("[AdminCommands] %s received %s from %s (total: %d)"):format(
		player.Name,
		foodDefinition.DisplayName or foodDefinition.ItemId,
		EAT_COMMAND_NAME,
		updatedCount
	))
end

local function handle_chat_command(requestingPlayer: Player, message: string): ()
	local normalizedMessage = normalize(message)
	local isEatCommand = normalizedMessage == EAT_COMMAND_NAME
	local isSetCoinsCommand = string.match(normalizedMessage, "^!setcoins") ~= nil
	if not isEatCommand and not isSetCoinsCommand then
		return
	end

	local hasAccess = AdminAccessService.HasAccess(requestingPlayer)
	if not hasAccess then
		warn(("[AdminCommands] %s tried to use %s without elevated permission"):format(
			requestingPlayer.Name,
			COMMAND_NAME
		))
		return
	end

	if isEatCommand then
		grant_random_food(requestingPlayer)
		return
	end

	local targetName, amount = parse_set_coins_command(message)
	if not targetName or amount == nil then
		warn(("[AdminCommands] Invalid %s syntax from %s. Expected: %s <player> <amount>"):format(
			COMMAND_NAME,
			requestingPlayer.Name,
			COMMAND_NAME
		))
		return
	end

	local targetPlayer = resolve_target_player(requestingPlayer, targetName)
	if not targetPlayer then
		warn(("[AdminCommands] %s could not find a unique online player for %q"):format(
			requestingPlayer.Name,
			targetName
		))
		return
	end

	DataUtility.server.set(targetPlayer, "Currencies.Horseshoes", amount)
	print(("[AdminCommands] %s set %s's Horseshoes to %d"):format(
		requestingPlayer.Name,
		targetPlayer.Name,
		amount
	))
end

function Commands.Bind(TroveValue: any): ()
	local boundPlayers: { [Player]: boolean } = {}

	local function bind_player(player: Player): ()
		if boundPlayers[player] then
			return
		end

		boundPlayers[player] = true
		TroveValue:Connect(player.Chatted, function(message: string): ()
			task.spawn(handle_chat_command, player, message)
		end)
	end

	for _, player: Player in Players:GetPlayers() do
		bind_player(player)
	end

	TroveValue:Connect(Framework.RuntimeEvents.PlayerAdded, bind_player)
	TroveValue:Connect(Framework.RuntimeEvents.PlayerRemoving, function(player: Player): ()
		boundPlayers[player] = nil
	end)
end

return Commands
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="235">
          <Properties>
            <string name="Name">Operations</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameData = Modules:WaitForChild("GameData")
local Utility = Modules:WaitForChild("Utility")
local ServerModules = ServerStorage:WaitForChild("Modules")
local AdminModules = ServerModules:WaitForChild("Admin")
local HorseModules = ServerModules:WaitForChild("Horse")

local Network = require(Modules:WaitForChild("Network"))
local ToolItemCatalog = require(GameData:WaitForChild("ToolItemCatalog"))
local HorseStatusService = require(Utility:WaitForChild("Horse"):WaitForChild("HorseStatusService"))
local DataUtility = require(Utility:WaitForChild("DataUtility"))
local AdminAccessService = require(AdminModules:WaitForChild("AdminAccessService"))
local HorseRouletteService = require(HorseModules:WaitForChild("HorseRouletteService"))

local Operations = {}

local function get_items_root()
	local assetsFolder = ReplicatedStorage:FindFirstChild("Assets")
	if not assetsFolder then
		return nil
	end

	return assetsFolder:FindFirstChild("Items")
end

local function normalize_key(value)
	return ToolItemCatalog.NormalizeKey(value)
end

local function resolve_item_definition_from_tool(tool)
	return ToolItemCatalog.ResolveDefinitionFromTool(tool)
end

local function get_category_folder(categoryName)
	local itemsRoot = get_items_root()
	if not itemsRoot then
		return nil
	end

	local folder = itemsRoot:FindFirstChild(categoryName)
	if folder and folder:IsA("Folder") then
		return folder
	end

	return nil
end

local function build_catalog()
	local itemsRoot = get_items_root()
	local categories = {}

	if not itemsRoot then
		return categories
	end

	for _, categoryFolder in ipairs(itemsRoot:GetChildren()) do
		if categoryFolder:IsA("Folder") then
			local categoryItems = {}

			for _, child in ipairs(categoryFolder:GetChildren()) do
				if child:IsA("Tool") then
					local itemDefinition = resolve_item_definition_from_tool(child)
					if itemDefinition then
						ToolItemCatalog.ApplyToolMetadata(child, itemDefinition)
					end

					local resolvedItemId = normalize_key(child:GetAttribute("ToolItemId"))
						or normalize_key(child:GetAttribute("ItemId"))
						or normalize_key(child.Name)

					if itemDefinition then
						resolvedItemId = itemDefinition.ItemId
					end

					categoryItems[#categoryItems + 1] = {
						Name = itemDefinition and itemDefinition.DisplayName or child.Name,
						ItemId = resolvedItemId or child.Name,
						PriceLabel = child:GetAttribute("PlaceholderPriceLabel")
							or (itemDefinition and itemDefinition.PriceLabel)
							or "",
						ToolTip = child.ToolTip ~= "" and child.ToolTip
							or (itemDefinition and itemDefinition.ToolTip)
							or "",
					}
				end
			end

			table.sort(categoryItems, function(a, b)
				return string.lower(a.Name) < string.lower(b.Name)
			end)

			categories[#categories + 1] = {
				Name = categoryFolder.Name,
				ItemCount = #categoryItems,
				Items = categoryItems,
			}
		end
	end

	table.sort(categories, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	return categories
end

local function clone_tool_to_backpack(player, toolTemplate)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false, "BackpackMissing"
	end

	local itemDefinition = resolve_item_definition_from_tool(toolTemplate)
	if itemDefinition then
		ToolItemCatalog.ApplyToolMetadata(toolTemplate, itemDefinition)
	end

	toolTemplate:Clone().Parent = backpack
	return true, "Granted"
end

function Operations.Bind(TroveValue: any): ()
	Network.Admin.GetItemCatalog:Respond(function(player)
	local hasAccess = AdminAccessService.HasAccess(player)
	if not hasAccess then
		return {
			Success = false,
			Code = "AccessDenied",
		}
	end

	return {
		Success = true,
		Categories = build_catalog(),
	}
end, TroveValue)

	Network.Admin.RequestItemTool:Respond(function(player, request)
	local hasAccess = AdminAccessService.HasAccess(player)
	if not hasAccess then
		return {
			Success = false,
			Code = "AccessDenied",
		}
	end

	if type(request) ~= "table" then
		return {
			Success = false,
			Code = "InvalidRequest",
		}
	end

	local mode = request.Mode
	local categoryName = request.CategoryName
	if type(categoryName) ~= "string" or categoryName == "" then
		return {
			Success = false,
			Code = "CategoryMissing",
		}
	end

	local categoryFolder = get_category_folder(categoryName)
	if not categoryFolder then
		return {
			Success = false,
			Code = "CategoryNotFound",
		}
	end

	if mode == "Category" then
		local grantedCount = 0
		for _, child in ipairs(categoryFolder:GetChildren()) do
			if child:IsA("Tool") then
				local success = clone_tool_to_backpack(player, child)
				if success then
					grantedCount += 1
				end
			end
		end

		return {
			Success = grantedCount > 0,
			Code = grantedCount > 0 and "CategoryGranted" or "NoToolsFound",
			GrantedCount = grantedCount,
		}
	end

	if mode == "Single" then
		local itemId = request.ItemId
		if type(itemId) ~= "string" or itemId == "" then
			return {
				Success = false,
				Code = "ItemMissing",
			}
		end

		for _, child in ipairs(categoryFolder:GetChildren()) do
			if child:IsA("Tool") then
				local toolItemId = normalize_key(child:GetAttribute("ToolItemId"))
					or normalize_key(child:GetAttribute("ItemId"))
					or normalize_key(child.Name)
				if toolItemId == normalize_key(itemId) then
					local success, code = clone_tool_to_backpack(player, child)
					return {
						Success = success,
						Code = code,
						ItemName = child.Name,
					}
				end
			end
		end

		return {
			Success = false,
			Code = "ItemNotFound",
		}
	end

	return {
		Success = false,
		Code = "UnsupportedMode",
	}
end, TroveValue)

	Network.Admin.GetHorseRouletteState:Respond(function(player)
	local hasAccess = AdminAccessService.HasAccess(player)
	if not hasAccess then
		return {
			Success = false,
			Code = "AccessDenied",
		}
	end

	return HorseRouletteService.GetState(player)
end, TroveValue)

	Network.Admin.RollHorseRoulette:Respond(function(player, request)
	local hasAccess = AdminAccessService.HasAccess(player)
	if not hasAccess then
		return {
			Success = false,
			Code = "AccessDenied",
		}
	end

	return HorseRouletteService.Roll(player, request)
end, TroveValue)

	Network.Admin.RestoreEquippedHorseNeeds:Respond(function(player)
	local hasAccess = AdminAccessService.HasAccess(player)
	if not hasAccess then
		return {
			Success = false,
			Code = "AccessDenied",
		}
	end

	local horses = DataUtility.server.get(player, "Horses")
	local equippedHorseId = horses and horses.EquippedHorseId or nil
	local horse = equippedHorseId and horses and horses.Owned and horses.Owned[equippedHorseId] or nil
	if not horse then
		return {
			Success = false,
			Code = "EquippedHorseNotFound",
		}
	end

	local now = os.time()
	HorseStatusService.NormalizeHorse(horse, now)
	local needs = horse.Needs
	needs.Modifiers = {}
	needs.ActiveEffects = {}

	for _, statusName in ipairs(HorseStatusService.StatusOrder) do
		needs.Values[statusName] = math.max(1, tonumber(needs.Max[statusName]) or 100)
	end

	needs.LastUpdatedAt = now
	DataUtility.server.set(player, "Horses", horses)

	return {
		Success = true,
		HorseId = equippedHorseId,
		HorseName = (type(horse.Nickname) == "string" and horse.Nickname ~= "" and horse.Nickname)
			or horse.DisplayName
			or horse.CatalogId
			or equippedHorseId,
	}
end, TroveValue)
end

return Operations
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="236">
        <Properties>
          <string name="Name">CharacterFolderRuntime</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))

local CHARACTERS_FOLDER_NAME: string = "Characters"

local CharacterFolderRuntime = {
	Name = "CharacterFolderRuntime",
	Trove = nil :: any,
	CharactersFolder = nil :: Folder?,
}

function CharacterFolderRuntime:_EnsureFolder(): Folder
	if self.CharactersFolder and self.CharactersFolder.Parent == workspace then
		return self.CharactersFolder
	end

	local Existing: Instance? = workspace:FindFirstChild(CHARACTERS_FOLDER_NAME)
	if Existing and Existing:IsA("Folder") then
		self.CharactersFolder = Existing
		return Existing
	end

	local FolderValue: Folder = Instance.new("Folder")
	FolderValue.Name = CHARACTERS_FOLDER_NAME
	FolderValue.Parent = workspace
	self.CharactersFolder = FolderValue
	return FolderValue
end

function CharacterFolderRuntime:Init(): ()
	if self.Trove then
		return
	end

	self.Trove = Trove.new()
	self.Trove:Connect(Framework.RuntimeEvents.CharacterAdded, function(_Player: Player, Character: Model): ()
		if Character.Parent then
			Character.Parent = self:_EnsureFolder()
		end
	end)
end

function CharacterFolderRuntime:Start(): ()
	self:_EnsureFolder()
end

function CharacterFolderRuntime:Destroy(): ()
	if self.Trove then
		self.Trove:Destroy()
		self.Trove = nil
	end
	self.CharactersFolder = nil
end

return CharacterFolderRuntime
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="237">
