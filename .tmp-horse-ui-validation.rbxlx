            <Item class="ModuleScript" referent="107">
              <Properties>
                <string name="Name">Crossing</string>
                <string name="Source"><![CDATA[--!strict

local Crossing = {}

function Crossing.CrossedCenter(PreviousSignedCoordinate: number, SignedCoordinate: number): boolean
	return PreviousSignedCoordinate > 0 and SignedCoordinate <= 0
end

function Crossing.CanCapture(
	IsJumping: boolean,
	WasJumping: boolean,
	LandedAt: number?,
	Now: number,
	GraceSeconds: number
): boolean
	if IsJumping or WasJumping then
		return true
	end
	if not LandedAt or Now < LandedAt then
		return false
	end

	return Now - LandedAt <= GraceSeconds
end

return table.freeze(Crossing)
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="108">
              <Properties>
                <string name="Name">Scoring</string>
                <string name="Source"><![CDATA[--!strict

export type Rating = "Perfect" | "Good" | "Bad"

export type Metrics = {
	TimingAlpha: number,
	AlignmentAlpha: number,
	EdgeAlpha: number,
	RhythmAlpha: number,
}

local TIMING_WEIGHT: number = 0.35
local ALIGNMENT_WEIGHT: number = 0.3
local EDGE_WEIGHT: number = 0.15
local RHYTHM_WEIGHT: number = 0.2
local PERFECT_THRESHOLD: number = 0.82
local GOOD_THRESHOLD: number = 0.55

local Scoring = {}

local function IsFinite(Value: number): boolean
	return Value == Value and Value ~= math.huge and Value ~= -math.huge
end

local function NormalizeAlpha(Value: number): number
	if not IsFinite(Value) then
		return 0
	end

	return math.clamp(Value, 0, 1)
end

function Scoring.Calculate(MetricsValue: Metrics): (Rating, number)
	local NormalizedScore: number =
		(NormalizeAlpha(MetricsValue.TimingAlpha) * TIMING_WEIGHT)
		+ (NormalizeAlpha(MetricsValue.AlignmentAlpha) * ALIGNMENT_WEIGHT)
		+ (NormalizeAlpha(MetricsValue.EdgeAlpha) * EDGE_WEIGHT)
		+ (NormalizeAlpha(MetricsValue.RhythmAlpha) * RHYTHM_WEIGHT)
	local Score: number = math.floor((NormalizedScore * 100) + 0.5)

	if NormalizedScore >= PERFECT_THRESHOLD then
		return "Perfect", Score
	end
	if NormalizedScore >= GOOD_THRESHOLD then
		return "Good", Score
	end

	return "Bad", Score
end

return table.freeze(Scoring)
]]></string>
              </Properties>
