      <Item class="ModuleScript" referent="247">
        <Properties>
          <string name="Name">NpcIdleRuntime</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))

local NPCS_FOLDER_NAME: string = "Npcs"
local DEFAULT_FADE_TIME: number = 0.15

local NPC_IDLE_ANIMATIONS: { [string]: string } = {
	chef = "rbxassetid://122382477972816",
	cowboy = "rbxassetid://92691472480288",
	doctor = "rbxassetid://99194435491936",
	farmer = "rbxassetid://122382477972816",
	noob = "rbxassetid://92691472480288",
}

local R6_PART_NAMES: { string } = {
	"Head",
	"Torso",
	"HumanoidRootPart",
	"Left Arm",
	"Right Arm",
	"Left Leg",
	"Right Leg",
}

local NpcIdleRuntime = {
	Name = "NpcIdleRuntime",
	Trove = nil :: any,
	NpcTroves = {} :: { [Instance]: any },
}

local function FindR6Humanoid(Npc: Model): Humanoid?
	local HumanoidValue: Humanoid? = Npc:FindFirstChildOfClass("Humanoid")
		or Npc:FindFirstChildWhichIsA("Humanoid", true)
	if not HumanoidValue or HumanoidValue.RigType ~= Enum.HumanoidRigType.R6 then
		return nil
	end

	for _Index: number, PartName: string in R6_PART_NAMES do
		local PartValue: Instance? = Npc:FindFirstChild(PartName)
		if not PartValue or not PartValue:IsA("BasePart") then
			return nil
		end
	end
	return HumanoidValue
end

function NpcIdleRuntime:_CleanupNpc(Npc: Instance): ()
	local NpcTrove: any = self.NpcTroves[Npc]
	if NpcTrove then
		NpcTrove:Destroy()
		self.NpcTroves[Npc] = nil
	end
end

function NpcIdleRuntime:_BindNpc(Npc: Instance): ()
	self:_CleanupNpc(Npc)
	if not Npc:IsA("Model") then
		return
	end

	local AnimationId: string? = NPC_IDLE_ANIMATIONS[string.lower(Npc.Name)]
	local Humanoid: Humanoid? = FindR6Humanoid(Npc)
	if not Humanoid or not AnimationId then
		if AnimationId and not Humanoid then
			warn(`[NpcIdleRuntime] NPC '{Npc.Name}' is not a valid R6 dummy`)
		end
		return
	end

	local Animator: Animator? = Humanoid:FindFirstChildOfClass("Animator")
	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	local AnimationValue: Animation = Instance.new("Animation")
	AnimationValue.AnimationId = AnimationId
	local Success: boolean, TrackOrError: any = pcall(Animator.LoadAnimation, Animator, AnimationValue)
	if not Success then
		AnimationValue:Destroy()
		warn(`[NpcIdleRuntime] Failed to load idle animation for {Npc:GetFullName()}: {tostring(TrackOrError)}`)
		return
	end

	local Track: AnimationTrack = TrackOrError
	local NpcTrove: any = Trove.new()
	self.NpcTroves[Npc] = NpcTrove
	NpcTrove:Add(AnimationValue)
	NpcTrove:Add(function(): ()
		pcall(function(): ()
			Track:Stop(DEFAULT_FADE_TIME)
			Track:Destroy()
		end)
	end)
	Track.Looped = true
	Track.Priority = Enum.AnimationPriority.Idle
	Track:Play(DEFAULT_FADE_TIME, 1, 1)
end

function NpcIdleRuntime:Init(): ()
	if self.Trove then
		return
	end
	self.Trove = Trove.new()
end

function NpcIdleRuntime:Start(): ()
	local Npcs: Folder = workspace:WaitForChild(NPCS_FOLDER_NAME) :: Folder
	for _Index: number, Npc: Instance in Npcs:GetChildren() do
		self:_BindNpc(Npc)
	end
	self.Trove:Connect(Npcs.ChildAdded, function(Npc: Instance): ()
		task.defer(function(): ()
			self:_BindNpc(Npc)
		end)
	end)
	self.Trove:Connect(Npcs.ChildRemoved, function(Npc: Instance): ()
		self:_CleanupNpc(Npc)
	end)
end

function NpcIdleRuntime:Destroy(): ()
	for Npc: Instance in table.clone(self.NpcTroves) do
		self:_CleanupNpc(Npc)
	end
	if self.Trove then
		self.Trove:Destroy()
		self.Trove = nil
	end
end

return NpcIdleRuntime
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="248">
        <Properties>
          <string name="Name">PlayerLifecycle</string>
          <string name="Source"><![CDATA[--!strict

local Players: Players = game:GetService("Players")
local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local Framework: any = require(Modules:WaitForChild("Framework"))
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))

local PlayerLifecycle = {
	Name = "PlayerLifecycle",
	Trove = nil :: any,
	PlayerTroves = {} :: { [Player]: any },
}

function PlayerLifecycle:_TrackPlayer(Player: Player): ()
	if self.PlayerTroves[Player] then
		return
	end

	local PlayerTrove: any = Trove.new()
	self.PlayerTroves[Player] = PlayerTrove
	PlayerTrove:Connect(Player.CharacterAdded, function(Character: Model): ()
		Framework.RuntimeEvents.CharacterAdded:Fire(Player, Character)
	end)
	PlayerTrove:Connect(Player.CharacterRemoving, function(Character: Model): ()
		Framework.RuntimeEvents.CharacterRemoving:Fire(Player, Character)
	end)

	Framework.RuntimeEvents.PlayerAdded:Fire(Player)
	if Player.Character then
		Framework.RuntimeEvents.CharacterAdded:Fire(Player, Player.Character)
	end
end

function PlayerLifecycle:_UntrackPlayer(Player: Player): ()
	Framework.RuntimeEvents.PlayerRemoving:Fire(Player)

	local PlayerTrove: any = self.PlayerTroves[Player]
	if PlayerTrove then
		PlayerTrove:Destroy()
		self.PlayerTroves[Player] = nil
	end
end

function PlayerLifecycle:Init(): ()
	if self.Trove then
		return
	end

	self.Trove = Trove.new()
	self.Trove:Connect(Players.PlayerAdded, function(Player: Player): ()
		self:_TrackPlayer(Player)
	end)
	self.Trove:Connect(Players.PlayerRemoving, function(Player: Player): ()
		self:_UntrackPlayer(Player)
	end)
end

function PlayerLifecycle:Start(): ()
	for _Index: number, Player: Player in Players:GetPlayers() do
		self:_TrackPlayer(Player)
	end
end

function PlayerLifecycle:Destroy(): ()
	if not self.Trove then
		return
	end

	for Player: Player in table.clone(self.PlayerTroves) do
		self:_UntrackPlayer(Player)
	end
	self.Trove:Destroy()
	self.Trove = nil
end

return PlayerLifecycle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="249">
        <Properties>
          <string name="Name">PlotRuntime</string>
          <string name="Source"><![CDATA[--!strict

------------------//SERVICES
local Players: Players = game:GetService("Players")
local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

------------------//CONSTANTS
local PLOT_VALUE_NAME = "Plot"
local PLOT_NUMBER_ATTRIBUTE = "PlotNumber"
local PLOT_NUMBER_LOWER_ATTRIBUTE = "plotnumber"
local OWNER_USER_ID_ATTRIBUTE = "OwnerUserId"
local OWNER_NAME_ATTRIBUTE = "OwnerName"
local STABLE_LEVEL_ATTRIBUTE = "StableLevel"
local HAS_HAY_BALE_FOLDER_ATTRIBUTE = "HasHayBaleFolder"
local HAS_HORSE_WATER_ATTRIBUTE = "HasHorseWater"
local HAY_BALE_FOLDER_NAME = "HayBaleFolder"
local HORSE_WATER_FOLDER_NAME = "HorseWater"
local STABLE_PREVIEWS_FOLDER_NAME = "StablePreviews"

type PlotData = {
	instance: Instance,
	number: number,
}

------------------//VARIABLES
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Libraries = Modules:WaitForChild("Libraries")
local ServerModules = ServerStorage:WaitForChild("Modules")
local HorseModules = ServerModules:WaitForChild("Horse")
local StableDictionary = require(Modules:WaitForChild("Dictionary"):WaitForChild("StableDictionary"))
local DataUtility = require(Modules:WaitForChild("Utility"):WaitForChild("DataUtility"))
local Framework = require(Modules:WaitForChild("Framework"))
local Network = require(Modules:WaitForChild("Network"))
local HorseRoamingService = require(HorseModules:WaitForChild("HorseRoamingService"))
local HorseService = require(HorseModules:WaitForChild("HorseService"))
local AdminAccessService = require(ServerModules:WaitForChild("Admin"):WaitForChild("AdminAccessService"))
local Trove = require(Libraries:WaitForChild("Trove"))
local Layout = require(script.Layout)
local Prompts = require(script.Prompts)

local assignedPlotByPlayer: {[Player]: PlotData} = {}
local plotOwnerByInstance: {[Instance]: Player} = {}
local playerTroves: {[Player]: any} = {}
local activeLevelByPlayer: {[Player]: number} = {}
local changingLevelByPlayer: {[Player]: boolean} = {}
local promptRuntime: any = nil
local disable_plot_slot_prompts: (Instance) -> ()

------------------//FUNCTIONS
local function set_plot_number_attributes(instance: Instance, plotNumber: number?): ()
	instance:SetAttribute(PLOT_NUMBER_ATTRIBUTE, plotNumber)
	instance:SetAttribute(PLOT_NUMBER_LOWER_ATTRIBUTE, plotNumber)
end

local function ensure_plot_value(player: Player): ObjectValue
	local plotValue = player:FindFirstChild(PLOT_VALUE_NAME)
	if plotValue and plotValue:IsA("ObjectValue") then
		return plotValue
	end

	if plotValue then
		plotValue:Destroy()
	end

	local newPlotValue = Instance.new("ObjectValue")
	newPlotValue.Name = PLOT_VALUE_NAME
	newPlotValue.Parent = player

	return newPlotValue
end

local function clear_plot_metadata(player: Player): ()
	local plotValue = player:FindFirstChild(PLOT_VALUE_NAME)
	if plotValue and plotValue:IsA("ObjectValue") then
		plotValue.Value = nil
	end

	set_plot_number_attributes(player, nil)
	player:SetAttribute(STABLE_LEVEL_ATTRIBUTE, nil)
end

local function set_plot_metadata(player: Player, plot: Instance, plotNumber: number): ()
	local plotValue = ensure_plot_value(player)
	plotValue.Value = plot
	set_plot_number_attributes(player, plotNumber)
end

local get_player_spawn = Layout.GetPlayerSpawn
local ensure_horse_folder_layout = Layout.EnsureHorseFolder
local get_ordered_plots = Layout.GetOrderedPlots

local function assign_plot(player: Player): PlotData?
	local currentPlot = assignedPlotByPlayer[player]
	if currentPlot and currentPlot.instance.Parent then
		set_plot_metadata(player, currentPlot.instance, currentPlot.number)
		return currentPlot
	end

	for _, plotData: PlotData in get_ordered_plots() do
		if not plotOwnerByInstance[plotData.instance] then
			ensure_horse_folder_layout(plotData.instance)
			assignedPlotByPlayer[player] = plotData
			plotOwnerByInstance[plotData.instance] = player

			plotData.instance:SetAttribute(OWNER_USER_ID_ATTRIBUTE, player.UserId)
			plotData.instance:SetAttribute(OWNER_NAME_ATTRIBUTE, player.Name)
			set_plot_metadata(player, plotData.instance, plotData.number)

			return plotData
		end
	end

	warn("No free plot found for " .. player.Name)
	clear_plot_metadata(player)

	return nil
end

local function release_plot(player: Player): ()
	local plotData = assignedPlotByPlayer[player]
	if plotData then
		HorseService.ClearPlotHorses(plotData.instance)
		disable_plot_slot_prompts(plotData.instance)

		if plotOwnerByInstance[plotData.instance] == player then
			plotOwnerByInstance[plotData.instance] = nil
		end

		if plotData.instance.Parent then
			plotData.instance:SetAttribute(OWNER_USER_ID_ATTRIBUTE, nil)
			plotData.instance:SetAttribute(OWNER_NAME_ATTRIBUTE, nil)
		end
	end

	assignedPlotByPlayer[player] = nil
	activeLevelByPlayer[player] = nil
	changingLevelByPlayer[player] = nil
	clear_plot_metadata(player)
end

local function cleanup_player(player: Player): ()
	if promptRuntime then
		promptRuntime:CleanupPlayer(player)
	end

	local playerTrove = playerTroves[player]
	if not playerTrove then
		return
	end

	playerTrove:Destroy()
	playerTroves[player] = nil
end

local get_level_plot_template = Layout.GetLevelPlotTemplate
local replace_plot_contents = Layout.ReplacePlotContents

local function publish_stable_previews(): ()
	local previewFolder = ReplicatedStorage:FindFirstChild(STABLE_PREVIEWS_FOLDER_NAME)
	if previewFolder and not previewFolder:IsA("Folder") then
		previewFolder:Destroy()
		previewFolder = nil
	end
	if not previewFolder then
		previewFolder = Instance.new("Folder")
		previewFolder.Name = STABLE_PREVIEWS_FOLDER_NAME
		previewFolder.Parent = ReplicatedStorage
	end

	local plots = get_ordered_plots()
	local previewPlot = plots[1]
	if not previewPlot then
		return
	end

	for level = StableDictionary.DefaultLevel, StableDictionary.MaxLevel do
		local previewName = StableDictionary.get_level_template_name(level)
		if not previewFolder:FindFirstChild(previewName) then
			local template = get_level_plot_template(level, previewPlot.number)
			if template then
				local cloned, preview = pcall(function()
					return template:Clone()
				end)
				if cloned and preview then
					for _, descendant in preview:GetDescendants() do
						if descendant:IsA("Script") or descendant:IsA("LocalScript") then
							descendant:Destroy()
						end
					end
					preview.Name = previewName
					preview.Parent = previewFolder
				else
					warn(("[PlotRuntime] Could not publish preview for %s"):format(previewName))
				end
			end
		end
	end
end

local function sync_plot_horses(player: Player): ()
	local plotData = assignedPlotByPlayer[player] or assign_plot(player)
	if not plotData then
		return
	end

	HorseService.SyncPlotHorses(player, plotData.instance)
end

promptRuntime = Prompts.new(assignedPlotByPlayer, sync_plot_horses)
disable_plot_slot_prompts = function(plot: Instance): ()
	promptRuntime:Disable(plot)
end
local function refresh_plot_slot_prompts(player: Player): ()
	promptRuntime:RefreshSlots(player)
end
local function rebind_plot_slot_prompts(player: Player, plot: Instance): ()
	promptRuntime:Rebind(player, plot)
end

local function set_player_plot_level(player: Player, requestedLevel, deferDataSave: boolean?): (boolean, string)
	if player.Parent ~= Players then
		return false, "PlayerUnavailable"
	end

	if changingLevelByPlayer[player] then
		return false, "LevelChangeBusy"
	end

	local numericLevel = tonumber(requestedLevel)
	if not numericLevel or numericLevel % 1 ~= 0 then
		return false, "InvalidLevel"
	end

	local level = math.floor(numericLevel)
	if level < StableDictionary.DefaultLevel or level > StableDictionary.MaxLevel then
		return false, "InvalidLevel"
	end

	local plotData = assignedPlotByPlayer[player] or assign_plot(player)
	if not plotData then
		return false, "PlotMissing"
	end

	local template = get_level_plot_template(level, plotData.number)
	if not template then
		return false, "LevelPlotTemplateMissing"
	end

	local stable = DataUtility.server.get(player, "Stable")
	if player.Parent ~= Players then
		return false, "PlayerUnavailable"
	elseif type(stable) ~= "table" then
		return false, "StableDataMissing"
	end

	changingLevelByPlayer[player] = true
	HorseRoamingService.ReturnPlayerHorsesToStable(player)
	HorseService.ClearPlotHorses(plotData.instance)
	disable_plot_slot_prompts(plotData.instance)

	local replaced, replaceReason = replace_plot_contents(plotData.instance, template)
	if not replaced then
		changingLevelByPlayer[player] = nil
		rebind_plot_slot_prompts(player, plotData.instance)
		sync_plot_horses(player)
		warn(("[PlotRuntime] Failed to apply %s for %s: %s"):format(
			template.Name,
			player.Name,
			replaceReason
		))
		return false, replaceReason
	end

	ensure_horse_folder_layout(plotData.instance)
	activeLevelByPlayer[player] = level
	plotData.instance:SetAttribute(STABLE_LEVEL_ATTRIBUTE, level)
	plotData.instance:SetAttribute(
		HAS_HAY_BALE_FOLDER_ATTRIBUTE,
		plotData.instance:FindFirstChild(HAY_BALE_FOLDER_NAME) ~= nil
	)
	plotData.instance:SetAttribute(
		HAS_HORSE_WATER_ATTRIBUTE,
		plotData.instance:FindFirstChild(HORSE_WATER_FOLDER_NAME) ~= nil
	)
	player:SetAttribute(STABLE_LEVEL_ATTRIBUTE, level)
	rebind_plot_slot_prompts(player, plotData.instance)

	-- OwnedStalls and HorseSlots intentionally stay untouched: bought slots are
	-- player-wide and immediately become available in every level that contains
	-- their matching Slot folder.
	stable.Level = level
	if not deferDataSave then
		DataUtility.server.set(player, "Stable", stable)
	end
	sync_plot_horses(player)
	refresh_plot_slot_prompts(player)
	changingLevelByPlayer[player] = nil

	return true, StableDictionary.get_level_template_name(level)
end

local function purchase_stable_upgrade(player: Player): {[string]: any}
	if player.Parent ~= Players then
		return { Success = false, Code = "PlayerUnavailable" }
	end

	local stable = DataUtility.server.get(player, "Stable")
	if type(stable) ~= "table" then
		return { Success = false, Code = "StableDataMissing" }
	end

	local currentLevel = StableDictionary.get_normalized_level(stable.Level)
	local nextLevel = currentLevel + 1
	if nextLevel > StableDictionary.MaxLevel then
		return {
			Success = false,
			Code = "MaxLevel",
			CurrentLevel = currentLevel,
		}
	end

	local price = StableDictionary.get_level_upgrade_price(nextLevel)
	if type(price) ~= "number" or price < 0 then
		return {
			Success = false,
			Code = "UpgradeNotConfigured",
			CurrentLevel = currentLevel,
		}
	end

	local horseshoes = math.max(0, math.floor(tonumber(DataUtility.server.get(player, "Currencies.Horseshoes")) or 0))
	if horseshoes < price then
		return {
			Success = false,
			Code = "NotEnoughHorseshoes",
			CurrentLevel = currentLevel,
			NextLevel = nextLevel,
			Price = price,
			Horseshoes = horseshoes,
		}
	end

	local changed, reason = set_player_plot_level(player, nextLevel, true)
	if not changed then
		return {
			Success = false,
			Code = reason,
			CurrentLevel = currentLevel,
			NextLevel = nextLevel,
		}
	end

	DataUtility.server.begin_batch(player)
	DataUtility.server.set(player, "Stable", stable)
	DataUtility.server.set(player, "Currencies.Horseshoes", horseshoes - price)
	DataUtility.server.end_batch(player)

	return {
		Success = true,
		Code = "Upgraded",
		PreviousLevel = currentLevel,
		CurrentLevel = nextLevel,
		Horseshoes = horseshoes - price,
	}
end

local function restore_saved_plot_level(player: Player): ()
	local stable = DataUtility.server.get(player, "Stable")
	if type(stable) ~= "table" or player.Parent ~= Players then
		return
	end

	local savedLevel = StableDictionary.get_normalized_level(stable.Level)
	local changed, reason = set_player_plot_level(player, savedLevel)
	if not changed and reason == "LevelPlotTemplateMissing" and savedLevel ~= StableDictionary.DefaultLevel then
		set_player_plot_level(player, StableDictionary.DefaultLevel)
	end
end

local function handle_chat_command(player: Player, message: string): ()
	local requestedLevel = string.match(string.lower(message), "^%s*!level(%d+)%s*$")
	if not requestedLevel then
		return
	end

	local hasAdminAccess = AdminAccessService.HasAccess(player)
	if not hasAdminAccess then
		warn(("[PlotRuntime] %s tried to use a stable level command without admin access"):format(player.Name))
		return
	end

	local changed, reason = set_player_plot_level(player, requestedLevel)
	if not changed then
		warn(("[PlotRuntime] %s could not use !level%s: %s"):format(
			player.Name,
			requestedLevel,
			reason
		))
	end
end

local function teleport_character_to_plot(player: Player, character: Model): ()
	local plotData = assignedPlotByPlayer[player] or assign_plot(player)
	if not plotData then
		return
	end

	local playerSpawn = get_player_spawn(plotData.instance)
	if not playerSpawn then
		warn("Plot " .. plotData.instance.Name .. " has no valid PlayerSpawn for " .. player.Name)
		return
	end

	local rootPart = character:WaitForChild("HumanoidRootPart", 10)
	if not rootPart then
		warn("HumanoidRootPart not found for " .. player.Name)
		return
	end

	if not character.Parent or player.Parent ~= Players then
		return
	end

	set_plot_number_attributes(character, plotData.number)
	character:PivotTo(playerSpawn.CFrame * CFrame.new(0, 3, 0))
	sync_plot_horses(player)
end

local function teleport_player_to_plot(player: Player): ()
	local character = player.Character
	if not character then
		return
	end

	teleport_character_to_plot(player, character)
end

------------------//MAIN FUNCTIONS
local function on_character_added(player: Player, character: Model): ()
	task.defer(teleport_character_to_plot, player, character)
end

local function on_player_added(player: Player): ()
	cleanup_player(player)
	assign_plot(player)

	local playerTrove = Trove.new()
	playerTroves[player] = playerTrove

	local plotData = assignedPlotByPlayer[player]
	if plotData then
		rebind_plot_slot_prompts(player, plotData.instance)
	end

	local horsesConnection = DataUtility.server.bind(player, "Horses", function()
		sync_plot_horses(player)
	end)

	if horsesConnection then
		playerTrove:Add(horsesConnection)
	end

	local stableConnection = DataUtility.server.bind(player, "Stable", function(stable)
		sync_plot_horses(player)
		refresh_plot_slot_prompts(player)

		if type(stable) == "table" then
			local savedLevel = StableDictionary.get_normalized_level(stable.Level)
			if activeLevelByPlayer[player] ~= savedLevel and not changingLevelByPlayer[player] then
				task.defer(set_player_plot_level, player, savedLevel)
			end
		end
	end)

	if stableConnection then
		playerTrove:Add(stableConnection)
	end

	sync_plot_horses(player)

	playerTrove:Connect(player.Chatted, function(message: string)
		task.spawn(handle_chat_command, player, message)
	end)

	playerTrove:Add(task.spawn(restore_saved_plot_level, player))
end

local function on_player_removing(player: Player): ()
	cleanup_player(player)
	release_plot(player)
end

local PlotRuntime = {
	Name = "PlotRuntime",
	Trove = nil :: any,
}

function PlotRuntime:Init(): ()
	if self.Trove then
		return
	end

	self.Trove = Trove.new()
	publish_stable_previews()
	Network.Functions.StableSlotAction:Respond(function(Player: Player, Payload: any): any
		return promptRuntime:Execute(Player, Payload)
	end, self.Trove)
	Network.Events.TeleportToStable:Connect(teleport_player_to_plot, self.Trove)
	Network.Functions.UpgradeStable:Respond(purchase_stable_upgrade, self.Trove)
	self.Trove:Connect(Framework.RuntimeEvents.PlayerAdded, on_player_added)
	self.Trove:Connect(Framework.RuntimeEvents.PlayerRemoving, on_player_removing)
	self.Trove:Connect(Framework.RuntimeEvents.CharacterAdded, on_character_added)
end

function PlotRuntime:Destroy(): ()
	if not self.Trove then
		return
	end

	for Player: Player in table.clone(playerTroves) do
		on_player_removing(Player)
	end
	promptRuntime:Destroy()
	self.Trove:Destroy()
	self.Trove = nil
	table.clear(assignedPlotByPlayer)
	table.clear(plotOwnerByInstance)
	table.clear(activeLevelByPlayer)
	table.clear(changingLevelByPlayer)
end

return PlotRuntime
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="250">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")
local Workspace: Workspace = game:GetService("Workspace")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local StableDictionary: any = require(Modules:WaitForChild("Dictionary"):WaitForChild("StableDictionary"))

local STABLES_FOLDER_NAME: string = "Stables"
local STABLE_PLOT_NAME: string = "Stable"
local STABLE_PLOT_NAME_PREFIX: string = "Stable"
local PLAYER_SPAWN_NAME: string = "PlayerSpawn"
local PLOT_NUMBER_ATTRIBUTE: string = "PlotNumber"
local PLOT_NUMBER_LOWER_ATTRIBUTE: string = "plotnumber"
local HORSE_FOLDER_NAME: string = "HorseFolder"

export type PlotData = {
	instance: Instance,
	number: number,
}

local StablesFolder: Instance = Workspace:WaitForChild(STABLES_FOLDER_NAME)
local Layout = {}

function Layout.GetPlotNumber(Plot: Instance): number?
	local PlotNumber: number? = tonumber(Plot.Name)
	if PlotNumber then
		return PlotNumber
	end

	local MainAttribute: any = Plot:GetAttribute(PLOT_NUMBER_ATTRIBUTE)
	if typeof(MainAttribute) == "number" then
		return MainAttribute
	end
	local LowerAttribute: any = Plot:GetAttribute(PLOT_NUMBER_LOWER_ATTRIBUTE)
	return if typeof(LowerAttribute) == "number" then LowerAttribute else nil
end

function Layout.GetPlayerSpawn(Plot: Instance): BasePart?
	local PlayerSpawn: Instance? = Plot:FindFirstChild(PLAYER_SPAWN_NAME)
	return if PlayerSpawn and PlayerSpawn:IsA("BasePart") then PlayerSpawn else nil
end

function Layout.GetLevelFromTemplateName(TemplateName: string): number?
	local LevelText: string? = string.match(string.lower(TemplateName), "^%s*level%s*(%d+)%s*$")
	return if LevelText then tonumber(LevelText) else nil
end

function Layout.EnsureHorseFolder(Plot: Instance): Instance?
	local HorseFolder: Instance? = Plot:FindFirstChild(HORSE_FOLDER_NAME)
	local DirectSlots: { Instance } = {}
	for _Index: number, SlotName: string in StableDictionary.HorseSlotOrder do
		local DirectSlot: Instance? = Plot:FindFirstChild(SlotName)
		if DirectSlot then
			table.insert(DirectSlots, DirectSlot)
		end
	end

	if not HorseFolder and #DirectSlots > 0 then
		local NewHorseFolder: Folder = Instance.new("Folder")
		NewHorseFolder.Name = HORSE_FOLDER_NAME
		NewHorseFolder.Parent = Plot
		HorseFolder = NewHorseFolder
	end
	if HorseFolder then
		for _Index: number, DirectSlot: Instance in DirectSlots do
			DirectSlot.Parent = HorseFolder
		end
	end
	return HorseFolder
end

function Layout.GetOrderedPlots(): { PlotData }
	local Plots: { PlotData } = {}
	for _Index: number, Plot: Instance in StablesFolder:GetChildren() do
		local IsLevelTemplate: boolean = Layout.GetLevelFromTemplateName(Plot.Name) ~= nil
		local PlotNumber: number? = if IsLevelTemplate then nil else Layout.GetPlotNumber(Plot)
		if PlotNumber and Layout.GetPlayerSpawn(Plot) then
			table.insert(Plots, { instance = Plot, number = PlotNumber })
		end
	end

	if #Plots == 0 then
		local StableContainer: Instance? = Workspace:FindFirstChild(STABLE_PLOT_NAME)
		if StableContainer and not Layout.GetPlayerSpawn(StableContainer) then
			for _Index: number, Plot: Instance in StableContainer:GetChildren() do
				local PlotNumber: number? = Layout.GetPlotNumber(Plot)
				if PlotNumber and Layout.GetPlayerSpawn(Plot) then
					table.insert(Plots, { instance = Plot, number = PlotNumber })
				end
			end
		end
	end

	if #Plots == 0 then
		for _Index: number, Plot: Instance in Workspace:GetChildren() do
			local StableSuffix: string? = string.match(Plot.Name, `^{STABLE_PLOT_NAME_PREFIX}(%d*)$`)
			if StableSuffix ~= nil and Layout.GetPlayerSpawn(Plot) then
				local FallbackNumber: number? = if Plot.Name == STABLE_PLOT_NAME then 1 else tonumber(StableSuffix)
				local PlotNumber: number? = Layout.GetPlotNumber(Plot) or FallbackNumber
				if PlotNumber then
					table.insert(Plots, { instance = Plot, number = PlotNumber })
				end
			end
		end
	end

	table.sort(Plots, function(First: PlotData, Second: PlotData): boolean
		return First.number < Second.number
	end)
	return Plots
end

local function GetPlotTemplateFromLevel(LevelTemplate: Instance, PlotNumber: number): Instance?
	if Layout.GetPlayerSpawn(LevelTemplate) then
		return LevelTemplate
	end
	for _Index: number, Candidate: Instance in LevelTemplate:GetChildren() do
		if Layout.GetPlotNumber(Candidate) == PlotNumber and Layout.GetPlayerSpawn(Candidate) then
			return Candidate
		end
	end
	return nil
end

function Layout.GetLevelPlotTemplate(Level: number, PlotNumber: number): Instance?
	local Visited: { [Instance]: boolean } = {}
	local function Test(LevelTemplate: Instance): Instance?
		if Visited[LevelTemplate] or Layout.GetLevelFromTemplateName(LevelTemplate.Name) ~= Level then
			return nil
		end
		Visited[LevelTemplate] = true
		return GetPlotTemplateFromLevel(LevelTemplate, PlotNumber)
	end

	for _Index: number, Child: Instance in StablesFolder:GetChildren() do
		local Template: Instance? = Test(Child)
		if Template then
			return Template
		end
	end
	for _Index: number, Root: Instance in { Workspace, ServerStorage, ReplicatedStorage } do
		for _DescendantIndex: number, Descendant: Instance in Root:GetDescendants() do
			local Template: Instance? = Test(Descendant)
			if Template then
				return Template
			end
		end
	end
	return nil
end

local function AlignCloneToSpawn(LevelClone: Instance, TargetSpawn: BasePart): (boolean, string)
	local LevelSpawn: BasePart? = Layout.GetPlayerSpawn(LevelClone)
	if not LevelSpawn then
		return false, PLAYER_SPAWN_NAME .. "Missing"
	end

	local Offset: CFrame = TargetSpawn.CFrame * LevelSpawn.CFrame:Inverse()
	if LevelClone:IsA("Model") then
		LevelClone:PivotTo(Offset * LevelClone:GetPivot())
	else
		if LevelClone:IsA("BasePart") then
			LevelClone.CFrame = Offset * LevelClone.CFrame
		end
		for _Index: number, Descendant: Instance in LevelClone:GetDescendants() do
			if Descendant:IsA("BasePart") then
				Descendant.CFrame = Offset * Descendant.CFrame
			end
		end
	end
	return true, "Aligned"
end

function Layout.ReplacePlotContents(Plot: Instance, Template: Instance): (boolean, string)
	local TargetSpawn: BasePart? = Layout.GetPlayerSpawn(Plot)
	if not TargetSpawn then
		return false, "TargetPlayerSpawnMissing"
	end

	local CloneSucceeded: boolean, LevelClone: Instance? = pcall(function(): Instance
		return Template:Clone()
	end)
	if not CloneSucceeded or not LevelClone then
		return false, "TemplateCloneFailed"
	end

	local Aligned: boolean, AlignReason: string = AlignCloneToSpawn(LevelClone, TargetSpawn)
	if not Aligned then
		LevelClone:Destroy()
		return false, AlignReason
	end

	local ClonedSpawn: BasePart? = Layout.GetPlayerSpawn(LevelClone)
	for _Index: number, Child: Instance in Plot:GetChildren() do
		if Child ~= TargetSpawn then
			Child:Destroy()
		end
	end
	for _Index: number, Child: Instance in LevelClone:GetChildren() do
		if Child ~= ClonedSpawn then
			Child.Parent = Plot
		end
	end
	LevelClone:Destroy()
	return true, "Replaced"
end

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="251">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")

local Modules: Folder = ReplicatedStorage:WaitForChild("Modules") :: Folder
local StableDictionary: any = require(Modules:WaitForChild("Dictionary"):WaitForChild("StableDictionary"))
local HorseMountConfig: any = require(
	Modules:WaitForChild("GameData"):WaitForChild("Horse"):WaitForChild("HorseMountConfig")
)
local DataUtility: any = require(Modules:WaitForChild("Utility"):WaitForChild("DataUtility"))
local Trove: any = require(Modules:WaitForChild("Libraries"):WaitForChild("Trove"))
local HorseModules: Folder = ServerStorage:WaitForChild("Modules"):WaitForChild("Horse") :: Folder
local HorseRoamingService: any = require(HorseModules:WaitForChild("HorseRoamingService"))
local HorseService: any = require(HorseModules:WaitForChild("HorseService"))

local HORSE_FOLDER_NAME: string = "HorseFolder"
local SLOT_PROMPT_PART_NAME: string = "Proximity"
local SLOT_PROMPT_NAME: string = "BuyStableSlotPrompt"
local SLOT_PROMPT_HOLD_DURATION: number = 0
local SLOT_PROMPT_MAX_ACTIVATION_DISTANCE: number = tonumber(HorseMountConfig.StableMountPromptMaxActivationDistance) or 14
local STABLE_SLOT_PROMPT_ATTRIBUTE: string = "StableSlotPrompt"
local STABLE_SLOT_NAME_ATTRIBUTE: string = "StableSlotName"
local STABLE_HORSE_ID_ATTRIBUTE: string = "StableHorseId"
local STABLE_HORSE_FREE_ATTRIBUTE: string = "StableHorseFree"
local STABLE_CAN_BUY_ATTRIBUTE: string = "StableCanBuy"
local STABLE_PROMPT_AVAILABLE_ATTRIBUTE: string = "StablePromptAvailable"
local ACTION_COOLDOWN_SECONDS: number = 0.35
local DISTANCE_TOLERANCE: number = 4

local Prompts = {}
Prompts.__index = Prompts

local function GetOwnedStalls(Stable: any): number
	local OwnedStalls: number = tonumber(Stable and Stable.OwnedStalls) or StableDictionary.DefaultOwnedStalls
	return math.clamp(math.floor(OwnedStalls), 0, StableDictionary.MaxOwnedStalls or #StableDictionary.HorseSlotOrder)
end

local function GetSlotFolder(Plot: Instance, SlotName: string): Instance?
	local HorseFolder: Instance? = Plot:FindFirstChild(HORSE_FOLDER_NAME)
	return if HorseFolder then HorseFolder:FindFirstChild(SlotName) else nil
end

local function GetSlotPrompt(Plot: Instance, SlotName: string): ProximityPrompt?
	local SlotFolder: Instance? = GetSlotFolder(Plot, SlotName)
	local ProximityPart: Instance? = if SlotFolder then SlotFolder:FindFirstChild(SLOT_PROMPT_PART_NAME) else nil
	if not ProximityPart then
		return nil
	end
	if ProximityPart:IsA("ProximityPrompt") then
		return ProximityPart
	end
	for _Index: number, Child: Instance in ProximityPart:GetChildren() do
		if Child:IsA("ProximityPrompt") then
			return Child
		end
	end
	if not ProximityPart:IsA("BasePart") and not ProximityPart:IsA("Attachment") then
		return nil
	end

	local Prompt: ProximityPrompt = Instance.new("ProximityPrompt")
	Prompt.Name = SLOT_PROMPT_NAME
	Prompt.HoldDuration = SLOT_PROMPT_HOLD_DURATION
	Prompt.MaxActivationDistance = SLOT_PROMPT_MAX_ACTIVATION_DISTANCE
	Prompt.RequiresLineOfSight = false
	Prompt.Parent = ProximityPart
	return Prompt
end

function Prompts.new(AssignedPlotByPlayer: any, SyncPlotHorses: (Player) -> ()): any
	return setmetatable({
		_AssignedPlots = AssignedPlotByPlayer,
		_SyncHorses = SyncPlotHorses,
		_PlotTroves = {},
		_LastActionAt = {},
	}, Prompts)
end

function Prompts:Disable(Plot: Instance): ()
	for _Index: number, SlotName: string in StableDictionary.HorseSlotOrder do
		local SlotPrompt: ProximityPrompt? = GetSlotPrompt(Plot, SlotName)
		if SlotPrompt then
			SlotPrompt.Enabled = false
			SlotPrompt:SetAttribute(STABLE_PROMPT_AVAILABLE_ATTRIBUTE, false)
		end
	end
end

function Prompts:RefreshSlots(Player: Player): ()
	local PlotData: any = self._AssignedPlots[Player]
	if not PlotData then
		return
	end
	local Stable: any = DataUtility.server.get(Player, "Stable")
	if not Stable then
		self:Disable(PlotData.instance)
		return
	end

	local OwnedStalls: number = GetOwnedStalls(Stable)
	local HorseSlots: any = if type(Stable.HorseSlots) == "table" then Stable.HorseSlots else nil
	for SlotIndex: number, SlotName: string in StableDictionary.HorseSlotOrder do
		local Prompt: ProximityPrompt? = GetSlotPrompt(PlotData.instance, SlotName)
		if Prompt then
			local SlotPrice: number? = StableDictionary.get_slot_purchase_price(SlotName)
			local IsPurchasable: boolean = SlotIndex ~= 1
				and SlotIndex > OwnedStalls
				and SlotIndex == OwnedStalls + 1
				and type(SlotPrice) == "number"
				and SlotPrice > 0
			local HorseId: any = if HorseSlots then HorseSlots[SlotName] else nil
			local HasAssignedHorse: boolean = SlotIndex <= OwnedStalls
				and type(HorseId) == "string"
				and HorseId ~= ""
			local IsFree: boolean = HasAssignedHorse and HorseRoamingService.IsHorseFree(Player, HorseId)
			Prompt.Enabled = IsPurchasable or HasAssignedHorse
			Prompt:SetAttribute(STABLE_PROMPT_AVAILABLE_ATTRIBUTE, Prompt.Enabled)
			Prompt.HoldDuration = SLOT_PROMPT_HOLD_DURATION
			Prompt.ActionText = "Interact"
			Prompt.ObjectText = if HasAssignedHorse then "Your Horse" else `Stable Slot {SlotIndex}`
			Prompt.Style = Enum.ProximityPromptStyle.Custom
			Prompt.KeyboardKeyCode = Enum.KeyCode.E
			Prompt:SetAttribute(STABLE_SLOT_PROMPT_ATTRIBUTE, true)
			Prompt:SetAttribute(STABLE_SLOT_NAME_ATTRIBUTE, SlotName)
			Prompt:SetAttribute(STABLE_HORSE_ID_ATTRIBUTE, if HasAssignedHorse then HorseId else nil)
			Prompt:SetAttribute(STABLE_HORSE_FREE_ATTRIBUTE, IsFree)
			Prompt:SetAttribute(STABLE_CAN_BUY_ATTRIBUTE, IsPurchasable)
			Prompt:SetAttribute("StableSlotPrice", if IsPurchasable then SlotPrice else nil)
		end
	end
end

function Prompts:_Bind(Player: Player, _PlotTrove: any, Plot: Instance): ()
	self:RefreshSlots(Player)
end

local function GetRootPart(Player: Player): BasePart?
	local Character: Model? = Player.Character
	local RootPart: Instance? = if Character then Character:FindFirstChild("HumanoidRootPart") else nil
	return if RootPart and RootPart:IsA("BasePart") then RootPart else nil
end

local function GetPromptPosition(Prompt: ProximityPrompt): Vector3?
	local Parent: Instance? = Prompt.Parent
	if Parent and Parent:IsA("Attachment") then
		return Parent.WorldPosition
	end
	if Parent and Parent:IsA("BasePart") then
		return Parent.Position
	end
	return nil
end

function Prompts:Execute(Player: Player, Payload: any): any
	if type(Payload) ~= "table" then
		return { Success = false, Code = "InvalidPayload" }
	end

	local PlotData: any = self._AssignedPlots[Player]
	local SlotName: any = Payload.SlotName
	local Action: any = Payload.Action
	if not PlotData or type(SlotName) ~= "string" or type(Action) ~= "string" then
		return { Success = false, Code = "InvalidRequest" }
	end

	local Prompt: ProximityPrompt? = GetSlotPrompt(PlotData.instance, SlotName)
	local RootPart: BasePart? = GetRootPart(Player)
	local PromptPosition: Vector3? = if Prompt then GetPromptPosition(Prompt) else nil
	if not Prompt or not Prompt.Enabled or not RootPart or not PromptPosition then
		return { Success = false, Code = "Unavailable" }
	end
	if (RootPart.Position - PromptPosition).Magnitude > Prompt.MaxActivationDistance + DISTANCE_TOLERANCE then
		return { Success = false, Code = "TooFar" }
	end

	local Now: number = os.clock()
	local LastActionAt: number = tonumber(self._LastActionAt[Player]) or -math.huge
	if Now - LastActionAt < ACTION_COOLDOWN_SECONDS then
		return { Success = false, Code = "Cooldown" }
	end
	self._LastActionAt[Player] = Now

	if Action == "Buy" then
		local Success: boolean, Code: string, OwnedStalls: number? = HorseService.BuyStableSlot(Player, SlotName)
		self:RefreshSlots(Player)
		return {
			Success = Success,
			Code = Code,
			OwnedStalls = OwnedStalls,
		}
	end

	if Action == "ToggleFree" then
		local Stable: any = DataUtility.server.get(Player, "Stable")
		local HorseSlots: any = if type(Stable) == "table" then Stable.HorseSlots else nil
		local HorseId: any = if type(HorseSlots) == "table" then HorseSlots[SlotName] else nil
		if type(HorseId) ~= "string" or HorseId == "" then
			return { Success = false, Code = "HorseMissing" }
		end

		local Success: boolean = HorseRoamingService.ToggleHorseFree(Player, HorseId)
		if not Success then
			self._SyncHorses(Player)
		end
		self:RefreshSlots(Player)
		return {
			Success = Success,
			Code = if Success then "Updated" else "Unavailable",
			IsFree = HorseRoamingService.IsHorseFree(Player, HorseId),
		}
	end

	return { Success = false, Code = "UnknownAction" }
end

function Prompts:Rebind(Player: Player, Plot: Instance): ()
	self:CleanupPlayer(Player)
	local PlotTrove: any = Trove.new()
	self._PlotTroves[Player] = PlotTrove
	self:_Bind(Player, PlotTrove, Plot)
end

function Prompts:CleanupPlayer(Player: Player): ()
	local PlotTrove: any = self._PlotTroves[Player]
	if PlotTrove then
		PlotTrove:Destroy()
		self._PlotTroves[Player] = nil
	end
	self._LastActionAt[Player] = nil
end

function Prompts:Destroy(): ()
	for Player: Player in table.clone(self._PlotTroves) do
		self:CleanupPlayer(Player)
	end
	table.clear(self._LastActionAt)
end

return Prompts
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Script" referent="252">
      <Properties>
        <string name="Name">ServerBootup</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local ReplicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrameworkModule: ModuleScript = ReplicatedStorage
	:WaitForChild("Modules")
	:WaitForChild("Framework") :: ModuleScript
local Framework: any = require(FrameworkModule)
local Components: Folder = script.Parent:WaitForChild("Components") :: Folder
local NetworkRuntime: any = require(Components:WaitForChild("NetworkRuntime"))
local DataRuntime: any = require(Components:WaitForChild("DataRuntime"))
local PlayerLifecycle: any = require(Components:WaitForChild("PlayerLifecycle"))
local AdminRuntime: any = require(Components:WaitForChild("AdminRuntime"))
local HorseRuntime: any = require(Components:WaitForChild("HorseRuntime"))
local GameplayRuntime: any = require(Components:WaitForChild("GameplayRuntime"))
local CommerceRuntime: any = require(Components:WaitForChild("CommerceRuntime"))
local PlotRuntime: any = require(Components:WaitForChild("PlotRuntime"))
local CharacterFolderRuntime: any = require(Components:WaitForChild("CharacterFolderRuntime"))
local NpcIdleRuntime: any = require(Components:WaitForChild("NpcIdleRuntime"))

local SERVER_READY_ATTRIBUTE: string = "ServerReady"
local SERVER_FAILED_ATTRIBUTE: string = "ServerFailed"
local SERVER_ERROR_ATTRIBUTE: string = "ServerError"

FrameworkModule:SetAttribute(SERVER_READY_ATTRIBUTE, false)
FrameworkModule:SetAttribute(SERVER_FAILED_ATTRIBUTE, false)
FrameworkModule:SetAttribute(SERVER_ERROR_ATTRIBUTE, nil)

local Runtime: any = Framework.Lifecycle.new("Server", {
	NetworkRuntime,
	DataRuntime,
	PlayerLifecycle,
	AdminRuntime,
	HorseRuntime,
	GameplayRuntime,
	CommerceRuntime,
	PlotRuntime,
	CharacterFolderRuntime,
	NpcIdleRuntime,
})

local Success: boolean, ErrorValue: any = pcall(function(): ()
	Runtime:Start()
end)

if Success then
	Framework.RuntimeEvents.ServerStarted:Fire()
	FrameworkModule:SetAttribute(SERVER_READY_ATTRIBUTE, true)
else
	local Message: string = tostring(ErrorValue)
	FrameworkModule:SetAttribute(SERVER_FAILED_ATTRIBUTE, true)
	FrameworkModule:SetAttribute(SERVER_ERROR_ATTRIBUTE, Message)
	warn(`[ServerBootup] {Message}`)
end

game:BindToClose(function(): ()
	Framework.RuntimeEvents.ServerStopping:Fire()
	Runtime:Destroy()
end)
]]></string>
      </Properties>
    </Item>
